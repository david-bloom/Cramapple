{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/choice/**",
              "components/feedback/**",
              "components/hint/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/pane/**",
              "components/question/**",
              "components/rubric/**",
              "ui_kits/frq/**",
              "ui_kits/home/**",
              "ui_kits/mcq/**",
              "ui_kits/open-hand-frq/**",
              "ui_kits/open-hand-mcq/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bungee|Passion One|Source Sans 3|STIX Two Math))/i]",
        "message": "Font not provided by the design system. Available: Bungee, Passion One, Source Sans 3, STIX Two Math."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|onClick|type|children|key|ref|className|style|children)$/]",
        "message": "<ActionButton> doesn't accept that prop. Declared props: variant, disabled, onClick, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|hint|quiet|link)$/]",
        "message": "<ActionButton> variant must be one of 'primary' | 'hint' | 'quiet' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<ActionButton> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:primary|secondary|note|align|key|ref|className|style|children)$/]",
        "message": "<ActionRow> doesn't accept that prop. Declared props: primary, secondary, note, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionRow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:split|start)$/]",
        "message": "<ActionRow> align must be one of 'split' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|onChange|rows|onAttach|attachLabel|readOnly|count|key|ref|className|style|children)$/]",
        "message": "<AnswerField> doesn't accept that prop. Declared props: value, placeholder, onChange, rows, onAttach, attachLabel, readOnly, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onOpenMap|mapOpen|right|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, onOpenMap, mapOpen, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeepDiveSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<DeepDiveSection> doesn't accept that prop. Declared props: title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:verdict|earned|total|coaching|hintsUsed|marks|submitted|submittedLabel|key|ref|className|style|children)$/]",
        "message": "<FeedbackCard> doesn't accept that prop. Declared props: verdict, earned, total, coaching, hintsUsed, marks, submitted, submittedLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackCard'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:correct|incorrect)$/]",
        "message": "<FeedbackCard> verdict must be one of 'correct' | 'incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|source|height|children|key|ref|className|style|children)$/]",
        "message": "<GraphFrame> doesn't accept that prop. Declared props: caption, source, height, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HintGate'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|cost|state|onAsk|onConfirm|onCancel|onHide|children|key|ref|className|style|children)$/]",
        "message": "<HintGate> doesn't accept that prop. Declared props: name, cost, state, onAsk, onConfirm, onCancel, onHide, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HintGate'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|asking|open)$/]",
        "message": "<HintGate> state must be one of 'idle' | 'asking' | 'open'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:course|right|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: course, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaneShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:voice|title|eyebrow|right|footer|padded|children|style|key|ref|className|style|children)$/]",
        "message": "<PaneShell> doesn't accept that prop. Declared props: voice, title, eyebrow, right, footer, padded, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaneShell'] > JSXAttribute[name.name='voice'] > Literal[value!=/^(?:rubric|reference|work|hint|deepdive|question|plain)$/]",
        "message": "<PaneShell> voice must be one of 'rubric' | 'reference' | 'work' | 'hint' | 'deepdive' | 'question' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plate'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|children|style|key|ref|className|style|children)$/]",
        "message": "<Plate> doesn't accept that prop. Declared props: caption, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|topic|number|total|stem|points|mode|key|ref|className|style|children)$/]",
        "message": "<QuestionHeader> doesn't accept that prop. Declared props: eyebrow, topic, number, total, stem, points, mode."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOptionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|children|selected|verdict|showVerdict|eliminated|explanation|note|readCount|onSelect|key|ref|className|style|children)$/]",
        "message": "<RadioOptionRow> doesn't accept that prop. Declared props: letter, children, selected, verdict, showVerdict, eliminated, explanation, note, readCount, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOptionRow'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:correct|distractor)$/]",
        "message": "<RadioOptionRow> verdict must be one of 'correct' | 'distractor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RubricCriterionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|label|detail|state|points|interactive|onToggle|key|ref|className|style|children)$/]",
        "message": "<RubricCriterionRow> doesn't accept that prop. Declared props: code, label, detail, state, points, interactive, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='RubricCriterionRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:earned|revisit|taken|pending)$/]",
        "message": "<RubricCriterionRow> state must be one of 'earned' | 'revisit' | 'taken' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:earned|total|tone|label|size|key|ref|className|style|children)$/]",
        "message": "<ScoreChip> doesn't accept that prop. Declared props: earned, total, tone, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:earned|lost|neutral)$/]",
        "message": "<ScoreChip> tone must be one of 'earned' | 'lost' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ScoreChip> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyMapTopic'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|title|done|total|current|key|ref|className|style|children)$/]",
        "message": "<StudyMapTopic> doesn't accept that prop. Declared props: code, title, done, total, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:verdict|key|ref|className|style|children)$/]",
        "message": "<VerdictChip> doesn't accept that prop. Declared props: verdict."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictChip'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:correct|incorrect|Correct|Incorrect)$/]",
        "message": "<VerdictChip> verdict must be one of 'correct' | 'incorrect' | 'Correct' | 'Incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:on-brand|on-light|on-dark|mono)$/]",
        "message": "<Wordmark> tone must be one of 'on-brand' | 'on-light' | 'on-dark' | 'mono'."
      }
    ]
  },

##  5. PARENT INCENTIVE & ESCROW LAYER
-- Manages financial reward parameter bounds, active rules, and escrow ledger drawdowns
CREATE TABLE public.incentive_wallets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    parent_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE UNIQUE,
    escrow_balance NUMERIC(10, 2) NOT NULL DEFAULT 0.00 CHECK (escrow_balance >= 0.00)
);

CREATE TABLE public.incentive_rules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    parent_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    student_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    vendor reward_vendor NOT NULL,
    target_unit_id INT NOT NULL REFERENCES public.context_pinned_rubrics(unit_id),
    target_score VARCHAR(10) NOT NULL DEFAULT 'Score 4',
    payout_amount NUMERIC(10, 2) NOT NULL CHECK (payout_amount >= 5.00),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
 3. Row-Level Security (RLS) Policy InfrastructureTo ensure multi-tenant safety, data access constraints are applied directly at the database engine engine level rather than relying entirely on front-end code validation routines.SQL-- Turn on system parameters forcing policy checks
ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.student_grading_queue ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.student_mastery_logs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.incentive_rules ENABLE ROW LEVEL SECURITY;

-- Profiles Rules
CREATE POLICY "Allow public select visibility for mapped user structures"
    ON public.profiles FOR SELECT USING (true);

CREATE POLICY "Allow authenticated updates to own profile values"
    ON public.profiles FOR UPDATE USING (auth.uid() = id);

-- Student Logging Rules
CREATE POLICY "Students can only browse their personal performance telemetry blocks"
    ON public.student_mastery_logs FOR SELECT
    USING (auth.uid() = student_id);

CREATE POLICY "Parents can inspect telemetry blocks matching their structural student links"
    ON public.student_mastery_logs FOR SELECT
    USING (EXISTS (
        SELECT 1 FROM public.profiles 
        WHERE public.profiles.id = public.student_mastery_logs.student_id 
          AND public.profiles.parent_id = auth.uid()
    ));

-- Incentive Engine Rules
CREATE POLICY "Parents maintain unique read/write management states on custom rules"
    ON public.incentive_rules FOR ALL
    USING (auth.uid() = parent_id);

CREATE POLICY "Students can view active rules configured against their identifier tokens"
    ON public.incentive_rules FOR SELECT
    USING (auth.uid() = student_id);

##  1. USER PROFILES LAYER
-- Automatically maps core user details populated via Supabase Auth signup triggers
CREATE TABLE public.profiles (
    id UUID REFERENCES auth.users ON DELETE CASCADE PRIMARY KEY,
    full_name TEXT NOT NULL,
    role TEXT NOT NULL CHECK (role IN ('student', 'parent')),
    parent_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL, -- Asymmetric mapping linking kids to parents
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

---

##  2. KNOWLEDGE BASE & CURRICULUM LAYER
-- Holds explicit, unalterable grading parameters mapped to the closed-world assumption
CREATE TABLE public.context_pinned_rubrics (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    unit_id INT NOT NULL UNIQUE,
    unit_title VARCHAR(255) NOT NULL,
    rubric_payload JSONB NOT NULL, -- Core JSON block outlining explicit definition points
    target_max_points INT NOT NULL DEFAULT 3,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

---

##  3. LIVE STUDENT EXECUTION & QUEUE LAYER
-- Intercepts segmented student text responses before triggering Edge Function parsing
CREATE TABLE public.student_grading_queue (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    unit_id INT NOT NULL REFERENCES public.context_pinned_rubrics(unit_id) ON DELETE CASCADE,
    define_input TEXT NOT NULL CHECK (char_length(define_input) >= 15 AND char_length(define_input) <= 600),
    explain_input TEXT NOT NULL CHECK (char_length(explain_input) >= 15 AND char_length(explain_input) <= 1000),
    predict_input TEXT NOT NULL CHECK (char_length(predict_input) >= 15 AND char_length(predict_input) <= 600),
    status evaluation_state NOT NULL DEFAULT 'queued',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

---

##  4. FINALIZED PERFORMANCE TELEMETRY LAYER
-- Clean, index-optimized target for historical scorecard views and parent dashboards
CREATE TABLE public.student_mastery_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    unit_id INT NOT NULL REFERENCES public.context_pinned_rubrics(unit_id) ON DELETE CASCADE,
    points_earned INT NOT NULL,
    max_points INT NOT NULL,
    mastery_tier VARCHAR(10) NOT NULL CHECK (mastery_tier IN ('Score 3', 'Score 4', 'Score 5')),
    is_logic_gap BOOLEAN NOT NULL DEFAULT FALSE,
    raw_response_payload JSONB NOT NULL, -- Captures freeze-frame snapshots of sub-fields
    diagnostic_feedback JSONB NOT NULL,  -- Holds specific protocolActionPlan with [...] markers
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);


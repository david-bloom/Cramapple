<mjml>
  <mj-head>
    <mj-title>Your Cramapple verification code</mj-title>
    <mj-font name="Bungee" href="https://fonts.googleapis.com/css?family=Bungee" />
    <mj-font name="Passion One" href="https://fonts.googleapis.com/css?family=Passion+One:700" />
    <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css?family=Source+Sans+3:400,600,700" />
    <mj-style>body{margin:0;padding:0;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
table{border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0}
img{border:0;outline:none;text-decoration:none}
@media (max-width:620px){.px{padding-left:20px!important;padding-right:20px!important}.code{font-size:34px!important;letter-spacing:8px!important}}</mj-style>
  </mj-head>
  <mj-body background-color="#efedea" width="600px">
    <mj-raw>
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;">Here's a new code to verify your email.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#efedea" style="background-color:#efedea;">
<tr><td align="center" style="padding:0;">
<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">
<tr><td class="px" bgcolor="#f54900" style="background-color:#f54900;padding:20px 24px;font-family:'Bungee','Arial Black',Arial,sans-serif;font-size:20px;line-height:24px;color:#ffffff;letter-spacing:0.5px;">cramapple</td></tr>
<tr><td bgcolor="#1f56a8" height="3" style="height:3px;line-height:3px;font-size:3px;background-color:#1f56a8;">&nbsp;</td></tr>
<tr><td class="px" bgcolor="#ffffff" style="background-color:#ffffff;padding:32px 24px 12px 24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td style="padding:0 0 20px 0;"><div style="font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:12px;line-height:14px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:#5b6b78;">Verify your email</div></td></tr>
<tr><td style="padding:0 0 20px 0;"><h1 style="margin:0;font-family:'Passion One','Arial Narrow',Arial,sans-serif;font-weight:700;font-size:26px;line-height:28px;color:#16202a;">Confirm your email</h1></td></tr>
<tr><td style="padding:0 0 20px 0;"><p style="margin:0;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#16202a;">Here's a new code to verify <strong>{DATA_VARIABLE:emailAddress}</strong>. Enter it in Cramapple to finish setting up.</p></td></tr>
<tr><td style="padding:0 0 20px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="#f7f6f3" style="background-color:#f7f6f3;border:1px solid #c7c3bb;padding:20px 16px;"><div style="font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:12px;line-height:14px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:#5b6b78;padding-bottom:8px;">Your verification code</div><div class="code" style="font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:40px;line-height:44px;font-weight:700;letter-spacing:10px;color:#16202a;padding-left:10px;">{DATA_VARIABLE:token}</div><div style="font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#5b6b78;padding-top:8px;">{DATA_VARIABLE:expiryText} Never share this code.</div></td></tr></table></td></tr>
<tr><td style="padding:0 0 20px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#eaf1fb" style="background-color:#eaf1fb;padding:14px 16px;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#16407e;">Asked for more than one code? Use the newest one. Didn't sign up? Ignore this email.</td></tr></table></td></tr>
</table>
</td></tr>
<tr><td class="px" align="center" style="padding:24px;font-family:'Source Sans 3',Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;color:#5b6b78;">
<div style="font-weight:600;">Cramapple &middot; {DATA_VARIABLE:mailingAddress}</div>
<div style="padding-top:8px;">Sent because someone used {DATA_VARIABLE:emailAddress} on Cramapple.</div>
</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
    </mj-raw>
  </mj-body>
</mjml>

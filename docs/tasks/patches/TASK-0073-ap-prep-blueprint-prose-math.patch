+// DECISION-0121: every place QuestionExperience prints AUTHORED question prose goes through
+// ProseMath, so a row carrying \( \) or \[ \] is typeset instead of shown as LaTeX source.
+// A source-level guard: it fails if someone prints one of these fields bare again.
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+
+const src = readFileSync(
+  new URL("../../screens/question-experience/QuestionExperience.jsx", import.meta.url),
+  "utf8",
+);
+
+const SITES: Array<[string, string]> = [
+  ["stem", "<ProseMath text={item.stem} />"],
+  ["stimulus", "<ProseMath text={item.stimulus} />"],
+  ["rubric criterion label", "<ProseMath text={c.label} />"],
+  ["rubric minimum fix", "<ProseMath text={c.minimumFix} />"],
+  ["answer-key choice text", "<ProseMath text={c.text} />"],
+  ["answer-key rationale", "<ProseMath text={c.rationale} />"],
+];
+
+describe("prose maths wiring in QuestionExperience", () => {
+  it.each(SITES)("%s is rendered through ProseMath", (_name, jsx) => {
+    expect(src).toContain(jsx);
+  });
+
+  it("both the read-only and the selectable choice lists use it", () => {
+    expect(src.match(/<ProseMath text=\{c\.text\} \/><\/span>/g)).toHaveLength(2);
+  });
+
+  it("no authored prose field is printed bare any more", () => {
+    for (const bare of ["{item.stem}", "{item.stimulus}", "{c.label}", "{c.minimumFix}", "{c.rationale}"]) {
+      expect(src).not.toContain(`>${bare}<`);
+      expect(src).not.toContain(` ${bare}</p>`);
+    }
+    expect(src).not.toMatch(/<\/strong> \{c\.text\}/);
+  });
+
+  it("a student's own words and the grader's reason are deliberately NOT parsed as maths", () => {
+    // Student answers and model-written reasons are not authored content; rendering
+    // `\(` in them would let a student's typing change the page.
+    expect(src).not.toContain("<ProseMath text={c.reason}");
+    expect(src).not.toContain("<ProseMath text={exp.attempt");
+    expect(src).not.toContain("<ProseMath text={draft");
+  });
+});

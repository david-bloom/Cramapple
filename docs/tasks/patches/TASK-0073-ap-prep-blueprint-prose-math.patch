@@ -0,0 +1,23 @@
+// Renders question and teaching prose that may carry \( inline \) or \[ display \] maths.
+// Plain prose -- every row published today -- returns the string untouched, so adopting
+// this component on a surface changes nothing until a row actually contains maths.
+import { useMemo } from "react";
+import { Formula } from "@/components/content/Formula";
+import { splitProseMath } from "@/lib/prose-math";
+
+export function ProseMath({ text }: { text: string | null | undefined }) {
+  const parts = useMemo(() => (text ? splitProseMath(text) : []), [text]);
+  if (!text) return null;
+  if (parts.length === 1 && parts[0].kind === "text") return <>{text}</>;
+  return (
+    <>
+      {parts.map((part, i) =>
+        part.kind === "text" ? (
+          <span key={i}>{part.text}</span>
+        ) : (
+          <Formula key={i} tex={part.text} display={part.kind === "display"} />
+        ),
+      )}
+    </>
+  );
+}

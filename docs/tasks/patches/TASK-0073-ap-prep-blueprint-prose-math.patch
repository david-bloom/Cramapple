@@ -0,0 +1,114 @@
+// DECISION-0121: prose maths. Inline \( \) and display \[ \] are rendered; `$` is never maths in prose.
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import { ProseMath } from "@/components/content/ProseMath";
+import { hasProseMath, splitProseMath, stripProseMath } from "@/lib/prose-math";
+
+/** What the student sees: KaTeX keeps the LaTeX source in a MathML <annotation>, so assert on the visible layer. */
+const visible = (html: string) => html.replace(/<annotation[^>]*>[\s\S]*?<\/annotation>/g, "");
+const html = (text: string) => renderToStaticMarkup(<ProseMath text={text} />);
+
+describe("splitProseMath", () => {
+  it("splits inline and display spans from the prose around them", () => {
+    expect(splitProseMath("Let \\(f(x)=\\frac{x^2-4}{x-2}\\). Find the limit.")).toEqual([
+      { kind: "text", text: "Let " },
+      { kind: "inline", text: "f(x)=\\frac{x^2-4}{x-2}" },
+      { kind: "text", text: ". Find the limit." },
+    ]);
+    expect(splitProseMath("The average rate is\n\\[\\frac{f(b)-f(a)}{b-a}\\]\nover the interval.")).toEqual([
+      { kind: "text", text: "The average rate is\n" },
+      { kind: "display", text: "\\frac{f(b)-f(a)}{b-a}" },
+      { kind: "text", text: "\nover the interval." },
+    ]);
+  });
+
+  it("treats currency as plain text, however many dollar signs there are", () => {
+    // Real published stems and choices (AP Statistics). `$...$` would pair these up.
+    for (const s of [
+      "A raffle ticket pays $10 with probability 0.5, $20 with probability 0.3.",
+      "Mean $850 with SD $120. Calculate a 95% confidence interval.",
+      "$20", "-$0.40", "Omar earns $11,000 above his firm's mean while Lena earns $52,000.",
+    ]) {
+      expect(hasProseMath(s)).toBe(false);
+      expect(splitProseMath(s)).toEqual([{ kind: "text", text: s }]);
+      expect(html(s)).toBe(renderToStaticMarkup(<>{s}</>));
+    }
+  });
+
+  it("keeps an unclosed opener and an empty span literal", () => {
+    expect(splitProseMath("a \\(b without a closer")).toEqual([{ kind: "text", text: "a \\(b without a closer" }]);
+    expect(splitProseMath("a \\(\\) b")).toEqual([{ kind: "text", text: "a \\(\\) b" }]);
+  });
+
+  it("handles several spans and returns nothing for an empty string", () => {
+    expect(splitProseMath("\\(a\\) and \\(b\\)").map((s) => s.kind)).toEqual(["inline", "text", "inline"]);
+    expect(splitProseMath("")).toEqual([]);
+  });
+
+  it("a currency amount beside a real span does not interfere with it", () => {
+    const segs = splitProseMath("It costs $5. Find \\(\\frac{1}{2}\\) of it, or $10.");
+    expect(segs.map((s) => s.kind)).toEqual(["text", "inline", "text"]);
+    expect(segs[0].text).toBe("It costs $5. Find ");
+    expect(segs[2].text).toBe(" of it, or $10.");
+  });
+});
+
+describe("ProseMath", () => {
+  it("returns plain prose untouched, so nothing changes until a row carries maths", () => {
+    const s = "Which statement best describes the trend? (A) rises, (B) falls & flattens";
+    expect(html(s)).toBe(renderToStaticMarkup(<>{s}</>));
+    expect(html(s)).not.toContain("katex");
+  });
+
+  it("renders a compound quotient as a stacked fraction, not as its source", () => {
+    const out = html("Let \\(f(x)=\\frac{x^2-x-6}{x^2-4}\\). Which statement is true?");
+    expect(out).toContain("mfrac");
+    expect(out).toContain("Which statement is true?");
+    expect(visible(out)).not.toContain("\\frac");
+  });
+
+  it("sets display maths on its own line and inline maths in the sentence", () => {
+    const display = html("Average rate:\n\\[\\frac{214-190}{6-5}\\]");
+    expect(display).toContain("katex-display");
+    expect(display).toContain("ca-formula-display");
+    const inline = html("Find \\(\\frac{214-190}{6-5}\\) now");
+    expect(inline).not.toContain("katex-display");
+    expect(inline).toContain("ca-formula-inline");
+  });
+
+  it("renders fractions at full size, not at KaTeX's shrunk script size", () => {
+    // The legibility floor from DECISION-0120: a fraction in text style lands near 12px.
+    const out = html("\\(\\frac{f(a+h)-f(a)}{h}\\)");
+    expect(out).toContain("mfrac");
+    expect(out).not.toContain("mtight");
+    expect(out).not.toContain("size3");
+  });
+
+  it("falls back to the source rather than showing KaTeX red on bad input", () => {
+    const out = html("Bad: \\(\\frac{1}{ \\begin{unterminated\\) end");
+    expect(out).toContain("ca-formula-raw");
+    expect(out).not.toContain("katex-error");
+    expect(out).toContain("Bad:");
+    expect(out).toContain("end");
+  });
+
+  it("renders nothing for an empty or missing value", () => {
+    expect(html("")).toBe("");
+    expect(renderToStaticMarkup(<ProseMath text={null} />)).toBe("");
+    expect(renderToStaticMarkup(<ProseMath text={undefined} />)).toBe("");
+  });
+
+  it("escapes prose text, so authored angle brackets are not injected as HTML", () => {
+    const out = html("if x < 3 and y > 2 then \\(x\\)");
+    expect(out).toContain("&lt;");
+    expect(out).not.toContain("<3");
+  });
+});
+
+describe("stripProseMath", () => {
+  it("removes the delimiters and keeps the source, for the clipboard and assistive text", () => {
+    expect(stripProseMath("Let \\(f(x)=\\frac{1}{x}\\) be given.")).toBe("Let f(x)=\\frac{1}{x} be given.");
+    expect(stripProseMath("costs $5 and $10")).toBe("costs $5 and $10");
+  });
+});
diff --git a/src/lib/prose-math.ts b/src/lib/prose-math.ts
new file mode 100644
index 0000000..8134382
--- /dev/null
+++ b/src/lib/prose-math.ts
@@ -0,0 +1,62 @@
+// Mathematics inside question and teaching PROSE (stems, choices, rationales, criteria).
+//
+// DECISION-0121: in prose a compound quotient is stacked only when it stands on its own
+// line; inside a sentence it keeps the slash. So prose needs two notations:
+//   \( ... \)   inline maths, set in line with the sentence
+//   \[ ... \]   display maths, set on its own line
+//
+// Why not `$...$`, which the deep-dive notes use (see MathText in Formula.tsx)? Because
+// published prose already contains `$` as CURRENCY -- about 70 rows, mostly AP Statistics
+// ("pays $10 with probability 0.5, $20 with ..."). Two currency amounts in one string
+// would parse as a maths span and swallow the words between them. A backslash never
+// appears in prose, so `\(` and `\[` cannot collide with anything already published.
+//
+// Authoring note: write absolute value as \lvert x \rvert, never |x|. A stem line holding
+// a bare `|` next to another such line is read as a pipe table by parseStimulusBlocks.
+
+export type ProseSegment = { kind: "text" | "inline" | "display"; text: string };
+
+const PAIRS = [
+  { open: "\\(", close: "\\)", kind: "inline" },
+  { open: "\\[", close: "\\]", kind: "display" },
+] as const;
+
+/** True when the string contains any prose-maths opener. The fast path for plain prose. */
+export function hasProseMath(text: string): boolean {
+  return text.includes("\\(") || text.includes("\\[");
+}
+
+/**
+ * `a \(x\) b` -> [{a},{x,inline},{b}]. An opener with no closer, and an empty span,
+ * stay literal text rather than swallowing the rest of the string.
+ */
+export function splitProseMath(text: string): ProseSegment[] {
+  if (!hasProseMath(text)) return text ? [{ kind: "text", text }] : [];
+  const out: ProseSegment[] = [];
+  let buf = "";
+  let i = 0;
+  while (i < text.length) {
+    const pair = PAIRS.find((p) => text.startsWith(p.open, i));
+    if (pair) {
+      const start = i + pair.open.length;
+      const end = text.indexOf(pair.close, start);
+      const body = end === -1 ? "" : text.slice(start, end).trim();
+      if (end !== -1 && body) {
+        if (buf) out.push({ kind: "text", text: buf });
+        buf = "";
+        out.push({ kind: pair.kind, text: body });
+        i = end + pair.close.length;
+        continue;
+      }
+    }
+    buf += text[i];
+    i += 1;
+  }
+  if (buf) out.push({ kind: "text", text: buf });
+  return out;
+}
+
+/** The string with the delimiters removed and the LaTeX source kept, for the clipboard and aria text. */
+export function stripProseMath(text: string): string {
+  return splitProseMath(text).map((s) => s.text).join("");
+}

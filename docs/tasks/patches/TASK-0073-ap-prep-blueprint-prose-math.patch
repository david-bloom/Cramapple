+// The dev harness samples for prose maths (src/dev-harness/QxHarness.tsx, ?state=prose-math and
+// ?state=prose-math-frq) must carry real, parseable prose maths, or the visual check shows nothing.
+import { readFileSync } from "node:fs";
+import katex from "katex";
+import { describe, expect, it } from "vitest";
+import { splitProseMath } from "@/lib/prose-math";
+
+const load = (name: string) =>
+  JSON.parse(readFileSync(new URL(`../question-experience/__fixtures__/${name}`, import.meta.url), "utf8"));
+const parses = (tex: string) => !katex.renderToString(`\\displaystyle ${tex}`, { throwOnError: true, strict: false }).includes("katex-error");
+
+describe("prose-math harness fixtures", () => {
+  it("every MCQ choice is one inline stacked fraction that KaTeX parses", () => {
+    const fx = load("prose-math-mcq.json");
+    expect(fx.mcqChoices).toHaveLength(4);
+    for (const c of fx.mcqChoices) {
+      const segs = splitProseMath(c.choiceText);
+      expect(segs).toHaveLength(1);
+      expect(segs[0].kind).toBe("inline");
+      expect(segs[0].text).toContain("\\frac");
+      expect(parses(segs[0].text)).toBe(true);
+    }
+  });
+
+  it("the FRQ sample has a display-maths rubric line and a plain one", () => {
+    const fx = load("prose-math-frq-review.json");
+    const [c1, c2] = fx.criteria;
+    expect(splitProseMath(c1.learnerFacingText).some((s) => s.kind === "display" && parses(s.text))).toBe(true);
+    expect(splitProseMath(c2.learnerFacingText)).toEqual([{ kind: "text", text: c2.learnerFacingText }]);
+    expect(fx.grading.criterionResults.map((r: { criterionKey: string }) => r.criterionKey)).toEqual(
+      fx.criteria.map((c: { criterionKey: string }) => c.criterionKey),
+    );
+  });
+
+  it("the samples are synthetic and say so", () => {
+    expect(load("prose-math-mcq.json").item.title).toContain("synthetic");
+    expect(load("prose-math-frq-review.json").item.title).toContain("synthetic");
+  });
+});

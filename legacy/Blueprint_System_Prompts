🛠️ 2. Step-by-Step Implementation Milestone MapMilestone 1: Setup Core Table InfrastructureDeploy the data persistence structures and tracking schemas inside the Supabase SQL editor window. This separates raw student writing queues from finalized, audited scores.SQL-- Create an enumeration type for evaluation orchestration states
CREATE TYPE evaluation_state AS ENUM ('queued', 'processing', 'completed', 'failed');

-- Extended Student Ingestion Queue Table
CREATE TABLE public.student_grading_queue (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID NOT NULL,
    unit_id INT NOT NULL,
    define_input TEXT NOT NULL,
    explain_input TEXT NOT NULL,
    predict_input TEXT NOT NULL,
    status evaluation_state NOT NULL DEFAULT 'queued',
    retry_count INT NOT NULL DEFAULT 0,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Enable RLS on input layers
ALTER TABLE public.student_grading_queue ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Students can insert their own grading payloads"
    ON public.student_grading_queue
    FOR INSERT
    WITH CHECK (auth.uid() = student_id);

CREATE POLICY "Students can monitor their own queue rows"
    ON public.student_grading_queue
    FOR SELECT
    USING (auth.uid() = student_id);
Milestone 2: Establish Net-Worker Database TriggersCreate an asynchronous trigger pipeline inside the database. This monitors row creation events and automatically routes payloads to the external execution runtime.SQL-- Database Function to invoke Edge Webhook
CREATE OR REPLACE FUNCTION public.on_grading_row_inserted()
RETURNS TRIGGER AS $$
BEGIN
    -- Dispatches asynchronous HTTP POST trigger directly to target Supabase Edge Function
    PERFORM
      net.http_post(
        url := 'https://your-project-id.supabase.co/functions/v1/dual-engine-grader',
        headers := jsonb_build_object(
          'Content-Type', 'application/json',
          'Authorization', current_setting('request.headers', true)::jsonb->>'authorization'
        ),
        body := jsonb_build_object('queue_id', NEW.id),
        timeout_milliseconds := 30000
      );
    
    -- Progress state window tracking marker
    UPDATE public.student_grading_queue
    SET status = 'processing', updated_at = NOW()
    WHERE id = NEW.id;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Bind Function to Execution Queue Table
CREATE TRIGGER trigger_student_grading_queue_inserted
    AFTER INSERT ON public.student_grading_queue
    FOR EACH ROW
    EXECUTE FUNCTION public.on_grading_row_inserted();
Milestone 3: Develop the Multi-Stage Edge Function RoutineThis TypeScript endpoint executes directly inside the Supabase Edge network. It coordinates the data lookup, runs the prompt chains through the models, and verifies the output structure.TypeScript// supabase/functions/dual-engine-grader/index.ts
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.21.0"

serve(async (req) => {
  try {
    const supabaseUrl = Deno.env.get('SUPABASE_URL')!;
    const supabaseKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;
    const geminiApiKey = Deno.env.get('GEMINI_API_KEY')!;
    
    const supabase = createClient(supabaseUrl, supabaseKey);
    const { queue_id } = await req.json();

    // 1. Fetch raw student input and structural data fields
    const { data: queueRow, error: queueError } = await supabase
      .from('student_grading_queue')
      .select('*')
      .eq('id', queue_id)
      .single();

    if (queueError || !queueRow) throw new Error('Target queue data matching row footprint missing');

    const { data: rubricDoc } = await supabase
      .from('context_pinned_rubrics')
      .select('rubric_payload, target_max_points')
      .eq('unit_id', queueRow.unit_id)
      .single();

    if (!rubricDoc) throw new Error('Target contextual rubric parameters unavailable');

    // 2. Stage 1 Pass: Run deep grading prompt through Gemini 1.5 Pro
    const graderSystemPrompt = `ROLE: Senior AP Biology Evaluation Engine...`; // Insert exact text from PROMPT_GEMINI_PRO_GRADER.txt
    
    const proResponse = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${geminiApiKey}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ role: 'user', parts: [{ text: `Rubric: ${JSON.stringify(rubricDoc.rubric_payload)}. Student Input: Define="${queueRow.define_input}", Explain="${queueRow.explain_input}", Predict="${queueRow.predict_input}"` }] }],
        systemInstruction: { parts: [{ text: graderSystemPrompt }] },
        generationConfig: { temperature: 0.0 }
      })
    });
    
    const proRawData = await proResponse.json();
    const proTextResult = proRawData.candidates?.[0]?.content?.parts?.[0]?.text || '';

    // 3. Stage 2 Pass: Validate output structure through Gemini 1.5 Flash Guard
    const flashGuardSystemPrompt = `ROLE: Structural JSON Schema Auditor & Security Guard...`; // Insert exact text from PROMPT_GEMINI_FLASH_GUARD.txt

    const flashResponse = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiApiKey}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ role: 'user', parts: [{ text: proTextResult }] }],
        systemInstruction: { parts: [{ text: flashGuardSystemPrompt }] },
        generationConfig: { temperature: 0.0, responseMimeType: "application/json" }
      })
    });

    const flashRawData = await flashResponse.json();
    const verifiedFinalPayload = JSON.parse(flashRawData.candidates?.[0]?.content?.parts?.[0]?.text || '{}');

    // 4. Step 4: Commit verified output metrics to the student ledger
    await supabase.rpc('commit_verified_grading_transaction', {
      p_queue_id: queue_id,
      p_student_id: queueRow.student_id,
      p_unit_id: queueRow.unit_id,
      p_points_earned: verifiedFinalPayload.pointsAwarded ?? 0,
      p_max_points: rubricDoc.target_max_points,
      p_mastery_tier: verifiedFinalPayload.projectedScore ?? 'Score 3',
      p_is_logic_gap: verifiedFinalPayload.status === 'logic_gap',
      p_raw_payload: { D: queueRow.define_input, E: queueRow.explain_input, P: queueRow.predict_input },
      p_feedback: verifiedFinalPayload.feedback ?? {}
    });

    return new Response(JSON.stringify({ status: 'committed' }), { status: 200 });
  } catch (err) {
    return new Response(JSON.stringify({ error: err.message }), { status: 500 });
  }
});
Milestone 4: Database Transaction RoutineDeploy an atomic atomic transaction wrapper to guarantee data consistency. This ensures that ledger updates and queue clearing processes succeed or fail together as a single unit.SQLCREATE OR REPLACE FUNCTION public.commit_verified_grading_transaction(
    p_queue_id UUID,
    p_student_id UUID,
    p_unit_id INT,
    p_points_earned INT,
    p_max_points INT,
    p_mastery_tier VARCHAR,
    p_is_logic_gap BOOLEAN,
    p_raw_payload JSONB,
    p_feedback JSONB
) RETURNS VOID AS $$
BEGIN
    -- 1. Insert directly into finalized analytics logs
    INSERT INTO public.student_mastery_logs (
        student_id, unit_id, points_earned, max_points, mastery_tier, is_logic_gap, raw_response_payload, diagnostic_feedback
    ) VALUES (
        p_student_id, p_unit_id, p_points_earned, p_max_points, p_mastery_tier, p_is_logic_gap, p_raw_payload, p_feedback
    );

    -- 2. Clear state record updates from input queue tracker table
    UPDATE public.student_grading_queue
    SET status = 'completed', updated_at = NOW()
    WHERE id = p_queue_id;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

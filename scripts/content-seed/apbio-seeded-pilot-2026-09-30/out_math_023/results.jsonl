{"key":"apbio-mcq-sv-023-v2","kind":"mcq","model":"deepseek/deepseek-v4-pro","pass":"solve","ok":true,"object":{"chosen_label":"A","final_answer":"A. A peripheral protein attached to the cytoplasmic face of the plasma membrane","working":"High-salt washes disrupt ionic interactions and release peripheral membrane proteins without dissolving the bilayer, so Protein Y is peripheral, not integral or buried. Trypsin cannot cross an intact plasma membrane, so in intact cells it can reach only the extracellular face. Protein Y is not cleaved in intact cells, indicating it is not exposed on the extracellular surface. When cells are broken open, both faces become accessible, and trypsin then cleaves Protein Y, showing it is exposed on the cytoplasmic face.","defect":""},"usage":{"inputTokens":562,"inputTokenDetails":{"noCacheTokens":306,"cacheReadTokens":256},"outputTokens":2516,"outputTokenDetails":{"textTokens":142,"reasoningTokens":2374},"totalTokens":3078,"raw":{"prompt_tokens":562,"completion_tokens":2516,"prompt_cache_hit_tokens":256,"prompt_cache_miss_tokens":306,"total_tokens":3078,"prompt_tokens_details":{"cached_tokens":256},"completion_tokens_details":{"reasoning_tokens":2374}},"reasoningTokens":2374,"cachedInputTokens":256},"attempts":1,"mode":"object","ms":27189,"keyed_label":"A"}

{"key":"apbio-mcq-sv-023-v1","kind":"mcq","model":"deepseek/deepseek-v4-pro","pass":"solve","ok":true,"object":{"chosen_label":"B","final_answer":"A membrane-embedded protein with at least one region exposed on the extracellular surface","working":"Sodium carbonate at pH 11 strips peripheral proteins attached non-covalently to the membrane surface, but Protein X remains in the membrane fraction, so it is not a peripheral protein removed by this treatment. Triton X-100 dissolves the bilayer and releases embedded proteins into micelles; Protein X is released, indicating it is embedded in the membrane. Trypsin added to intact cells cannot cross the plasma membrane and cleaves only extracellular regions; Protein X is cleaved, so at least part of it faces the extracellular surface. Together these results support an integral membrane protein with an extracellular exposed region.","defect":""},"usage":{"inputTokens":591,"inputTokenDetails":{"noCacheTokens":335,"cacheReadTokens":256},"outputTokens":346,"outputTokenDetails":{"textTokens":164,"reasoningTokens":182},"totalTokens":937,"raw":{"prompt_tokens":591,"completion_tokens":346,"prompt_cache_hit_tokens":256,"prompt_cache_miss_tokens":335,"total_tokens":937,"prompt_tokens_details":{"cached_tokens":256},"completion_tokens_details":{"reasoning_tokens":182}},"reasoningTokens":182,"cachedInputTokens":256},"attempts":1,"mode":"object","ms":5354,"keyed_label":"B"}

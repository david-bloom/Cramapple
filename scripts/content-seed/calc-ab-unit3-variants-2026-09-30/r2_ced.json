[{"content_key": "u3-005-v1", "item_type": "mcq", "stem": "A signal is modeled by S(x) = e^(3x) cos x. What is S'(x)?", "stimulus": null, "criteria": ["A. -3e^(3x) sin(x)", "B. e^(3x)(cos(x) - 3sin(x))", "C. 3e^x cos(x)", "D. (correct) e^(3x)(3cos(x) - sin(x))"]}, {"content_key": "u3-007-v2", "item_type": "mcq", "stem": "An index is modeled by G(x) = (1 + x^4)^(1/3). What is G'(x)?", "stimulus": null, "criteria": ["A. 4x^3/(3(1+x^4)^(1/3))", "B. 4x^3(1+x^4)^(2/3)/3", "C. 1/(3(1+x^4)^(2/3))", "D. (correct) 4x^3/(3(1+x^4)^(2/3))"]}, {"content_key": "u3-008-v2", "item_type": "mcq", "stem": "A curve is given by 2x^2 - xy + y^2 = 8. What is dy/dx at the point (1, 3)?", "stimulus": null, "criteria": ["A. (correct) -1/5", "B. -5", "C. -1/6", "D. 1/5"]}]
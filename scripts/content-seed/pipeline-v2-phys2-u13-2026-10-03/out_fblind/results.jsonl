{"key":"apphy2-mcq-002","model":"google/gemini-3.8-flash","sample":1,"ok":true,"label":{"chosen_label":"C","working":"For an ideal gas, internal energy depends solely on temperature: U = (3/2)nRT. In an isothermal process, temperature remains constant (ΔT = 0), so the change in internal energy is zero.","more_than_one_defensible_choice":false,"scope_verdict":"fully_in_scope","out_of_scope_concepts":[],"primary_topic_code":"9.4","required_units":[9],"difficulty":"Easy"},"usage":{"inputTokens":8607,"inputTokenDetails":{"noCacheTokens":8607,"cacheReadTokens":0},"outputTokens":421,"outputTokenDetails":{"textTokens":140,"reasoningTokens":281},"totalTokens":9028,"raw":{"thoughtsTokenCount":281,"promptTokenCount":8607,"candidatesTokenCount":140,"totalTokenCount":9028,"trafficType":"ON_DEMAND","promptTokensDetails":[{"modality":"TEXT","tokenCount":8607}],"candidatesTokensDetails":[{"modality":"TEXT","tokenCount":140}]},"reasoningTokens":281,"cachedInputTokens":0},"ms":4300,"error":""}

{"key":"apphy2-mcq-002","model":"deepseek/deepseek-v4-pro","sample":1,"ok":true,"label":{"chosen_label":"C","working":"For an ideal gas, internal energy depends only on temperature: U = (3/2)nRT. Isothermal means ΔT = 0, so ΔU = 0. Choice D is dimensionally invalid because internal-energy change cannot equal pressure.","more_than_one_defensible_choice":false,"scope_verdict":"fully_in_scope","out_of_scope_concepts":[],"primary_topic_code":"9.4 The First Law of Thermodynamics","required_units":[9],"difficulty":"Easy"},"usage":{"inputTokens":8249,"inputTokenDetails":{"noCacheTokens":57,"cacheReadTokens":8192},"outputTokens":388,"outputTokenDetails":{"textTokens":139,"reasoningTokens":249},"totalTokens":8637,"raw":{"prompt_tokens":8249,"completion_tokens":388,"prompt_cache_hit_tokens":8192,"prompt_cache_miss_tokens":57,"total_tokens":8637,"prompt_tokens_details":{"cached_tokens":8192},"completion_tokens_details":{"reasoning_tokens":249}},"reasoningTokens":249,"cachedInputTokens":8192},"ms":4384,"error":""}
{"key":"apphy2-mcq-004","model":"deepseek/deepseek-v4-pro","sample":1,"ok":true,"label":{"chosen_label":"A","working":"Electric field direction is defined as the direction of the electric force on a positive test charge. A negative test charge would feel force opposite the field, a neutral object experiences no net electrostatic force, and an electron is only one specific negative charge, so A is uniquely correct.","more_than_one_defensible_choice":false,"scope_verdict":"fully_in_scope","out_of_scope_concepts":[],"primary_topic_code":"10.3 Electric Fields","required_units":[10],"difficulty":"Easy"},"usage":{"inputTokens":8255,"inputTokenDetails":{"noCacheTokens":63,"cacheReadTokens":8192},"outputTokens":389,"outputTokenDetails":{"textTokens":138,"reasoningTokens":251},"totalTokens":8644,"raw":{"prompt_tokens":8255,"completion_tokens":389,"prompt_cache_hit_tokens":8192,"prompt_cache_miss_tokens":63,"total_tokens":8644,"prompt_tokens_details":{"cached_tokens":8192},"completion_tokens_details":{"reasoning_tokens":251}},"reasoningTokens":251,"cachedInputTokens":8192},"ms":4465,"error":""}
{"key":"apphy2-mcq-002","model":"google/gemini-3.8-flash","sample":1,"ok":true,"label":{"chosen_label":"C","working":"An isothermal process occurs at constant temperature (ΔT = 0). Since the internal energy of an ideal gas depends solely on its temperature (U = 3/2 nRT), the change in internal energy during any isothermal process is zero.","more_than_one_defensible_choice":false,"scope_verdict":"fully_in_scope","out_of_scope_concepts":[],"primary_topic_code":"9.4","required_units":[9],"difficulty":"Easy"},"usage":{"inputTokens":8607,"inputTokenDetails":{"noCacheTokens":8607,"cacheReadTokens":0},"outputTokens":387,"outputTokenDetails":{"textTokens":143,"reasoningTokens":244},"totalTokens":8994,"raw":{"thoughtsTokenCount":244,"promptTokenCount":8607,"candidatesTokenCount":143,"totalTokenCount":8994,"trafficType":"ON_DEMAND","promptTokensDetails":[{"modality":"TEXT","tokenCount":8607}],"candidatesTokensDetails":[{"modality":"TEXT","tokenCount":143}]},"reasoningTokens":244,"cachedInputTokens":0},"ms":5100,"error":""}

 "APSTATS-MCQ-001": {
  "type": "mcq",
  "reg_topic": "1.7",
  "reg_unit": 1,
  "label_status": "validated",
  "key_disagree": [],
  "multi_defensible": [],
  "scope": [],
  "topics": [
   "1.7",
   "1.7"
  ],
  "units": [
   1,
   1
  ],
  "audit": [
   [
    "deepseek-v4-pro",
    "A",
    "Standard deviation is not 'pulled toward' the long right tail; it is a measure of spread and is inflated by the high outlier, not shifted in the direction of the tail."
   ],
   [
    "deepseek-v4-pro",
    "D",
    "The claim that shape and outliers affect the standard deviation 'just as much' as the mean is inaccurate; both are non-resistant but are not affected to the same degree."
   ]
  ]
 },
 "APSTATS-MCQ-001-CAL": {
  "type": "mcq",
  "reg_topic": "1.7",
  "reg_unit": 1,
  "label_status": "validated",
  "key_disagree": [],
  "multi_defensible": [],
  "scope": [],
  "topics": [
   "1.7",
   "1.7 Summary Statistics for One Quantitative Variable"
  ],
  "units": [
   1,
   1
  ],
  "audit": [
   [
    "deepseek-v4-pro",
    "A",
    "The mean is pulled toward the right tail, but the standard deviation is a measure of spread, not a center; it is inflated by the skew/outlier rather than 'pulled toward' the tail."
   ],
   [
    "deepseek-v4-pro",
    "D",
    "It correctly says the SD is non-resistant, but shape/outliers do not affect the SD 'just as much as' the mean; their sensitivities are not equal."
   ]
  ]
 },

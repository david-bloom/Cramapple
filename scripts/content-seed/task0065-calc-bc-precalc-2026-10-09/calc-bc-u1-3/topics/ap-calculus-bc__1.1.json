   "item": {
    "subject_key": "ap-calculus-bc",
    "unit_number": 1,
    "topic_code": "1.1",
    "topic_title": "Introducing Calculus: Can Change Occur at an Instant?",
    "stem": "A moving object's position at time t seconds is s(t) meters. Assume its instantaneous rate of change at t = 5 exists. Which procedure defines this instantaneous rate, rather than an average rate over a fixed interval?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Evaluate (s(5)−s(5))/(5−5).",
      "is_correct": false,
      "rationale": "Zero-interval substitution attempts to use an average-rate quotient at a single instant. This gives 0/0, which is undefined, not an instantaneous rate. Fix: Use nonzero time intervals and consider what their average rates approach."
     },
     {
      "choice_key": "B",
      "choice_text": "Compute (s(6)−s(4))/(6−4).",
      "is_correct": false,
      "rationale": "Fixed-interval confusion substitutes an average rate around the instant for the instantaneous rate. This quotient describes the entire interval from 4 to 6 seconds, even if it happens to equal the instantaneous rate. Fix: Shrink the interval toward t = 5 instead of keeping its endpoints fixed."
     },
     {
      "choice_key": "C",
      "choice_text": "Divide the position s(5) by the elapsed time 5.",
      "is_correct": false,
      "rationale": "Position-versus-change confusion treats position divided by time as an instantaneous rate. The quotient s(5)/5 does not generally measure even an average rate unless the initial position is zero. Fix: Compute position changes over shrinking time intervals, rather than dividing position by time."
     },
     {
      "choice_key": "D",
      "choice_text": "Find the value approached by average rates over nonzero time intervals containing t = 5 as those intervals shrink toward t = 5.",
      "is_correct": true,
      "rationale": "Average rates describe position change over time intervals. The instantaneous rate is the value these average rates approach as the intervals shrink toward the single instant."
     }
    ]
   },

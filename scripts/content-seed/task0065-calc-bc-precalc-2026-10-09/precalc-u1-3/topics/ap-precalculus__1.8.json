   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 1,
    "topic_code": "1.8",
    "topic_title": "Rational Functions and Zeros",
    "stem": "Let f(x) = (x²−x−6)/(x²−4). Which statement identifies all real zeros of f?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The zeros are x = −2 and x = 3.",
      "is_correct": false,
      "rationale": "Numerator-only error: Both values make the numerator zero, but −2 also makes the denominator zero. Because f is undefined at −2, that input cannot be a zero. Fix: Substitute each numerator zero into the original denominator before accepting it."
     },
     {
      "choice_key": "B",
      "choice_text": "The zeros are x = −2 and x = 2.",
      "is_correct": false,
      "rationale": "Denominator-zero confusion: These values solve x²−4 = 0, identifying excluded inputs rather than zeros of f. A zero requires a zero numerator and a nonzero denominator. Fix: Solve the numerator equation first, then reject values that make the denominator zero."
     },
     {
      "choice_key": "C",
      "choice_text": "The only zero is x = −3.",
      "is_correct": false,
      "rationale": "Sign-reversal error: The factor x−3 gives x = 3, not x = −3. Substituting −3 makes the numerator equal 6, so f(−3) ≠ 0. Fix: Set each numerator factor equal to zero and solve before checking the denominator."
     },
     {
      "choice_key": "D",
      "choice_text": "The only zero is x = 3.",
      "is_correct": true,
      "rationale": "The numerator factors as (x−3)(x+2), so its zeros are 3 and −2. The original denominator is zero at −2 but equals 5 at 3, so only 3 is a zero of f."
     }
    ]
   },

   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 2,
    "topic_code": "2.1",
    "topic_title": "Change in Arithmetic and Geometric Sequences",
    "stem": "A sequence is known to be either arithmetic or geometric. Its first four terms are 64, 32, 16, and 8. Which statement correctly identifies the sequence and its common difference or common ratio?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The sequence is geometric with common ratio 1/2.",
      "is_correct": true,
      "rationale": "The consecutive differences are −32, −16, and −8, so they are not constant. The consecutive ratios are 32/64 = 16/32 = 8/16 = 1/2, so the sequence is geometric."
     },
     {
      "choice_key": "B",
      "choice_text": "The sequence is arithmetic with common difference −32.",
      "is_correct": false,
      "rationale": "First-pair-only error: −32 is the difference between the first two terms, but the next differences are −16 and −8. An arithmetic sequence requires the same difference at every step. Fix: Compute all three consecutive differences before identifying a common difference."
     },
     {
      "choice_key": "C",
      "choice_text": "The sequence is geometric with common ratio 2.",
      "is_correct": false,
      "rationale": "Reciprocal-ratio error: dividing each term by the next gives 2, but the common ratio uses the next term divided by the current term. Multiplying by 2 would double the terms rather than halve them. Fix: Divide each next term by the term immediately before it."
     },
     {
      "choice_key": "D",
      "choice_text": "The sequence is geometric with common ratio −1/2.",
      "is_correct": false,
      "rationale": "Decrease-versus-sign confusion: decreasing positive terms do not imply a negative common ratio. Multiplying by −1/2 would alternate the signs of the terms. Fix: Compute consecutive ratios with their signs instead of inferring the sign from decreasing values."
     }
    ]
   },

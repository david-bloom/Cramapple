   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 2,
    "topic_code": "2.11",
    "topic_title": "Logarithmic Functions",
    "stem": "The logarithmic function f is defined by f(x) = −3 log₂(x) for x > 0. In the form f(x) = a·log_b(x), which statement correctly identifies a and b and describes the graph relative to y = log₂(x)?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "a = −2 and b = 3; the graph is reflected across the x-axis and stretched vertically by a factor of 2.",
      "is_correct": false,
      "rationale": "Coefficient–base confusion: This exchanges the magnitudes of the coefficient and base. In −3 log₂(x), the multiplier is −3, while the subscript specifies base 2. Fix: Identify the multiplier as a and the logarithm’s subscript as b."
     },
     {
      "choice_key": "B",
      "choice_text": "a = −3 and b = 2; the graph is reflected across the x-axis and stretched vertically by a factor of 3.",
      "is_correct": true,
      "rationale": "The multiplier −3 is a, and the logarithm’s subscript 2 is b. Multiplying every output by −3 reverses its sign and triples its magnitude, producing an x-axis reflection and a vertical stretch."
     },
     {
      "choice_key": "C",
      "choice_text": "a = −3 and b = 2; the graph is reflected across the y-axis and stretched vertically by a factor of 3.",
      "is_correct": false,
      "rationale": "Reflection-axis confusion: A negative multiplier outside the logarithm changes output signs, producing an x-axis reflection. A y-axis reflection would instead replace the input x with −x. Fix: Check whether the negative sign changes the input or the output."
     },
     {
      "choice_key": "D",
      "choice_text": "a = −3 and b = 2; the graph is reflected across the x-axis and compressed vertically by a factor of 1/3.",
      "is_correct": false,
      "rationale": "Stretch–compression reversal: Multiplying outputs by −3 triples their magnitudes rather than reducing them to one-third. The negative sign supplies the reflection, while |a| = 3 supplies the stretch. Fix: Compare |a| with 1 to distinguish a vertical stretch from a compression."
     }
    ]
   },

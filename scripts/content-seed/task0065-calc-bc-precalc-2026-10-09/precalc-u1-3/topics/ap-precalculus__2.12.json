   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 2,
    "topic_code": "2.12",
    "topic_title": "Logarithmic Function Manipulation",
    "stem": "For x > 0, which single logarithm is equivalent to 2log₃(x) + log₃(5) for every value of x?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "log₃(5x²)",
      "is_correct": true,
      "rationale": "The power property gives 2log₃(x) = log₃(x²). The product property then gives log₃(x²) + log₃(5) = log₃(5x²)."
     },
     {
      "choice_key": "B",
      "choice_text": "log₃(10x)",
      "is_correct": false,
      "rationale": "Coefficient-as-multiplier error: this replaces 2log₃(x) with log₃(2x). The coefficient becomes an exponent on x, not a multiplier of x. Fix: Move the coefficient to an exponent before combining the logarithms."
     },
     {
      "choice_key": "C",
      "choice_text": "log₃(x² + 5)",
      "is_correct": false,
      "rationale": "Sum-of-arguments error: this adds the arguments when combining a sum of logarithms. The product property requires multiplying the arguments, giving x² · 5 rather than x² + 5. Fix: Multiply the arguments when combining a sum of logarithms."
     },
     {
      "choice_key": "D",
      "choice_text": "log₃(25x²)",
      "is_correct": false,
      "rationale": "Misplaced-coefficient error: this applies the coefficient 2 to both logarithms, squaring both x and 5. Only log₃(x) has coefficient 2, so the factor 5 must remain unchanged. Fix: Apply the power property to each term separately before combining."
     }
    ]
   },

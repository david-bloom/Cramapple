   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 2,
    "topic_code": "2.3",
    "topic_title": "Exponential Functions",
    "stem": "Which function satisfies the requirements for an exponential function of the form f(x) = ab^x?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "f(x) = −6(−1/2)^x",
      "is_correct": false,
      "rationale": "Negative-base trap: A negative coefficient is allowed, but a negative base is not. Here b = −1/2 violates the requirement b > 0. Fix: Identify the base inside the parentheses and check that it is positive."
     },
     {
      "choice_key": "B",
      "choice_text": "f(x) = −6(1)^x",
      "is_correct": false,
      "rationale": "Constant-base trap: Having an exponent does not make every expression exponential. Here b = 1 makes the function constant and violates the requirement b ≠ 1. Fix: Check that the base differs from 1 before accepting an exponential function."
     },
     {
      "choice_key": "C",
      "choice_text": "f(x) = 0(1/2)^x",
      "is_correct": false,
      "rationale": "Zero-coefficient trap: Checking only the base misses the coefficient restriction. Here a = 0 makes the expression the zero function and violates the requirement a ≠ 0. Fix: Check that the coefficient multiplying the exponential expression is nonzero."
     },
     {
      "choice_key": "D",
      "choice_text": "f(x) = −6(1/2)^x",
      "is_correct": true,
      "rationale": "Here a = −6 is nonzero, and b = 1/2 is positive and not equal to 1. A negative initial value is allowed; the positivity requirement applies to the base, not the coefficient."
     }
    ]
   },

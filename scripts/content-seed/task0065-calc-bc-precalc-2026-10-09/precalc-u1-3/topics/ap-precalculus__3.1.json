   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 3,
    "topic_code": "3.1",
    "topic_title": "Periodic Phenomena",
    "stem": "A periodic signal completes 6 full cycles in 3 seconds, with each cycle taking the same amount of time. What is the period of the signal?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "1/2 second",
      "is_correct": true,
      "rationale": "The period is the time for one complete cycle. Dividing the total time by the number of cycles gives 3/6 = 1/2 second per cycle."
     },
     {
      "choice_key": "B",
      "choice_text": "2 seconds",
      "is_correct": false,
      "rationale": "Frequency–period confusion: 6/3 = 2 is the frequency in cycles per second, not the period in seconds per cycle. Fix: Take the reciprocal of the frequency to find the period."
     },
     {
      "choice_key": "C",
      "choice_text": "3 seconds",
      "is_correct": false,
      "rationale": "Total-time confusion: 3 seconds is the time for all 6 cycles, not for one cycle. Fix: Divide the total elapsed time by the number of complete cycles."
     },
     {
      "choice_key": "D",
      "choice_text": "1/6 second",
      "is_correct": false,
      "rationale": "Cycle-count-as-frequency error: Taking 1/6 treats the 6 cycles as occurring in one second, but they occur in 3 seconds. Fix: Compute cycles per second before taking the reciprocal."
     }
    ]
   },

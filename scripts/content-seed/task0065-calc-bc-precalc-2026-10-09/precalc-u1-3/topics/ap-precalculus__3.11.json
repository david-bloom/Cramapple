   "item": {
    "subject_key": "ap-precalculus",
    "unit_number": 3,
    "topic_code": "3.11",
    "topic_title": "The Secant, Cosecant, and Cotangent Functions",
    "stem": "For θ = π/3, cos θ = 1/2 and sin θ = √3/2. What is sec θ?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "1/2",
      "is_correct": false,
      "rationale": "Missing-reciprocal error: this is the given cosine value, not its reciprocal. Fix: Divide 1 by the cosine value to find secant."
     },
     {
      "choice_key": "B",
      "choice_text": "π/3",
      "is_correct": false,
      "rationale": "Reciprocal–inverse confusion: arccos(1/2) = π/3 returns an angle, whereas secant takes the reciprocal of a cosine value. Fix: Compute 1/(cos θ), not arccos(cos θ)."
     },
     {
      "choice_key": "C",
      "choice_text": "2√3/3",
      "is_correct": false,
      "rationale": "Wrong reciprocal pairing: 1/(sin θ) = 2/√3 = 2√3/3 gives cosecant, not secant. Fix: Pair secant with cosine before taking the reciprocal."
     },
     {
      "choice_key": "D",
      "choice_text": "2",
      "is_correct": true,
      "rationale": "Secant is the reciprocal of cosine, so sec θ = 1/(cos θ) = 1/(1/2) = 2."
     }
    ]
   },

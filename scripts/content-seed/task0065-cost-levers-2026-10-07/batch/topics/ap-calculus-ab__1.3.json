   "item": {
    "subject_key": "ap-calculus-ab",
    "unit_number": 1,
    "topic_code": "1.3",
    "topic_title": "Estimating Limit Values from Graphs",
    "stem": "Near x = 3, the graph of f has a left-hand branch approaching an open circle at (3, 2) and a right-hand branch approaching an open circle at (3, 6). A filled point is at (3, 8). What is lim x→3 f(x)?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "8",
      "is_correct": false,
      "rationale": "Function-value confusion: the filled point gives f(3) = 8, not the value approached by nearby graph branches. Neither branch approaches 8. Fix: Trace both nearby branches before using the filled point."
     },
     {
      "choice_key": "B",
      "choice_text": "2",
      "is_correct": false,
      "rationale": "One-sided reasoning: 2 is the left-hand limit, but the right-hand branch approaches 6. The left-hand behavior alone cannot establish a two-sided limit. Fix: Trace the graph toward x = 3 from the right as well."
     },
     {
      "choice_key": "C",
      "choice_text": "The limit does not exist.",
      "is_correct": true,
      "rationale": "The graph approaches 2 from the left and 6 from the right. A two-sided limit requires both sides to approach the same value, so this limit does not exist."
     },
     {
      "choice_key": "D",
      "choice_text": "4",
      "is_correct": false,
      "rationale": "Averaging unequal limits: averaging 2 and 6 gives 4, but neither branch approaches 4. A two-sided limit requires agreement, not an average. Fix: Compare the two approached values instead of averaging them."
     }
    ]
   },

   "item": {
    "subject_key": "ap-chemistry",
    "unit_number": 1,
    "topic_code": "1.2",
    "topic_title": "Mass Spectra of Elements",
    "stem": "A sample of an element contains only two isotopes. Its mass spectrum, obtained from singly charged monatomic ions, shows a peak at 50.0 amu with relative abundance 75.0% and a peak at 54.0 amu with relative abundance 25.0%. What is the average atomic mass of the element in this sample?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "52.0 amu",
      "is_correct": false,
      "rationale": "Equal-weight averaging gives (50.0 + 54.0)/2 = 52.0 amu, but this assumes equal isotope abundances. The spectrum instead shows three times as much of the lighter isotope. Fix: Multiply each isotope’s mass by its fractional abundance before adding."
     },
     {
      "choice_key": "B",
      "choice_text": "50.0 amu",
      "is_correct": false,
      "rationale": "The most-abundant-isotope trap treats the largest peak’s mass as the average. The heavier isotope also contributes, so the average must exceed 50.0 amu. Fix: Include a weighted contribution from every isotope peak."
     },
     {
      "choice_key": "C",
      "choice_text": "53.0 amu",
      "is_correct": false,
      "rationale": "Reversing the abundances gives (50.0 × 0.250) + (54.0 × 0.750) = 53.0 amu. This incorrectly assigns the larger abundance to the heavier isotope. Fix: Pair each peak’s mass with its own abundance before multiplying."
     },
     {
      "choice_key": "D",
      "choice_text": "51.0 amu",
      "is_correct": true,
      "rationale": "Average atomic mass weights each isotope’s mass by its fractional abundance: (50.0 × 0.750) + (54.0 × 0.250) = 51.0 amu. The result is closer to 50.0 amu because that isotope is more abundant."
     }
    ]
   },

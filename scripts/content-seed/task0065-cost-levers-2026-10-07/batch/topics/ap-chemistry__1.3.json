   "item": {
    "subject_key": "ap-chemistry",
    "unit_number": 1,
    "topic_code": "1.3",
    "topic_title": "Elemental Composition of Pure Substances",
    "stem": "A sample of a pure compound contains only iron and oxygen: 112 g of Fe and 48 g of O. What is the empirical formula of the compound? Use molar masses of 56 g/mol for Fe and 16 g/mol for O.",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Fe₇O₃",
      "is_correct": false,
      "rationale": "Mass-ratio trap: Reducing 112:48 gives 7:3, but formula subscripts represent atom ratios, not mass ratios. Different elements have different molar masses. Fix: Convert each element’s mass to moles before comparing amounts."
     },
     {
      "choice_key": "B",
      "choice_text": "FeO₂",
      "is_correct": false,
      "rationale": "Premature-rounding trap: Dividing the mole amounts by 2 gives 1:1.5, not 1:2. Rounding 1.5 to 2 changes the composition rather than preserving the ratio. Fix: Multiply every ratio value by 2 when a half-integer remains."
     },
     {
      "choice_key": "C",
      "choice_text": "Fe₂O₃",
      "is_correct": true,
      "rationale": "The sample contains 112/56 = 2 mol Fe and 48/16 = 3 mol O. The simplest whole-number mole ratio is 2:3, so the empirical formula is Fe₂O₃."
     },
     {
      "choice_key": "D",
      "choice_text": "Fe₄O₆",
      "is_correct": false,
      "rationale": "Unreduced-ratio trap: A 4:6 atom ratio matches the composition, but it is not the lowest whole-number ratio. An empirical formula requires the simplest ratio. Fix: Divide all subscripts by their greatest common factor."
     }
    ]
   },

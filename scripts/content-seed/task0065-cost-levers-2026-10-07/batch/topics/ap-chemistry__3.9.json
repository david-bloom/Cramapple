   "item": {
    "subject_key": "ap-chemistry",
    "unit_number": 3,
    "topic_code": "3.9",
    "topic_title": "Separation of Solutions and Mixtures",
    "stem": "Two dyes, X and Y, are completely dissolved in water. In a paper chromatography setup, both dyes dissolve equally well in the moving solvent, but X is attracted more strongly than Y to the stationary paper. Which procedure and predicted result are best supported by this information?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Use paper chromatography; Y will travel farther from the starting line than X.",
      "is_correct": true,
      "rationale": "Chromatography separates substances through differences in their interactions with the stationary and mobile phases. Because X interacts more strongly with the paper while both dyes interact equally with the moving solvent, X moves less far than Y."
     },
     {
      "choice_key": "B",
      "choice_text": "Use ordinary filtration; both dyes will remain on the filter while the water passes through.",
      "is_correct": false,
      "rationale": "Dissolved-solute filtration error: Ordinary filtration separates suspended solids from a liquid, not dissolved dye molecules from water. These dyes are dissolved rather than present as suspended particles. Fix: Check whether the material to be removed is dissolved or suspended before choosing filtration."
     },
     {
      "choice_key": "C",
      "choice_text": "Use paper chromatography; X will travel farther from the starting line than Y.",
      "is_correct": false,
      "rationale": "Stationary-phase attraction reversal: Stronger attraction to the stationary paper holds a dye back rather than carrying it forward. X therefore travels less far than Y. Fix: Identify which phase moves, then determine which dye is held more strongly by the stationary phase."
     },
     {
      "choice_key": "D",
      "choice_text": "Use paper chromatography; X and Y will travel the same distance because they dissolve equally well in the moving solvent.",
      "is_correct": false,
      "rationale": "Mobile-phase-only reasoning: Equal solubility in the moving solvent does not guarantee equal travel distances. The dyes differ in their attraction to the stationary paper, allowing separation. Fix: Compare each dye’s interactions with both the moving solvent and the stationary paper."
     }
    ]
   },

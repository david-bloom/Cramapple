   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 1,
    "topic_code": "1.10",
    "topic_title": "The Investigative Question Revisited and Data Collection",
    "stem": "Researchers enroll employees who already walk to work and employees who already drive to work. They do not ask anyone to change commuting habits. Over the next six months, they record each employee’s days absent and compare the two groups. Which statement correctly classifies this study and explains why?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "It is a prospective observational study because researchers impose no treatment and collect absence data going forward.",
      "is_correct": true,
      "rationale": "The researchers observe existing commuting habits rather than assign them, so the study is observational. Recording absences over the next six months makes it prospective."
     },
     {
      "choice_key": "B",
      "choice_text": "It is a retrospective observational study because employees chose their commuting habits before the study began.",
      "is_correct": false,
      "rationale": "This is the preexisting-condition timing trap: existing commuting habits do not make the study retrospective. The absence data are collected going forward, not retrieved from past records. Fix: Identify when the study’s outcome data are collected relative to its start."
     },
     {
      "choice_key": "C",
      "choice_text": "It is an experiment because researchers repeatedly record employees’ absences over six months.",
      "is_correct": false,
      "rationale": "This is the tracking-equals-experiment trap: repeated measurements do not constitute an imposed treatment. The researchers record absences without assigning commuting habits. Fix: Check whether researchers impose a treatment or only record what happens."
     },
     {
      "choice_key": "D",
      "choice_text": "It is an experiment because researchers compare employees with two different commuting habits.",
      "is_correct": false,
      "rationale": "This is the comparison-equals-experiment trap: observational studies can also compare groups. Here, the employees’ commuting habits already exist and are not assigned by researchers. Fix: Check how the groups acquired their conditions before labeling the study an experiment."
     }
    ]
   },

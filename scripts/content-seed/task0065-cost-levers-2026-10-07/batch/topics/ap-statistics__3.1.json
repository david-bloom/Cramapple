   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 3,
    "topic_code": "3.1",
    "topic_title": "Estimators",
    "stem": "In a school district, 40% of students walk to school. A simple random sample of 50 students gives a sample proportion of 0.46 who walk to school. Averaging the sample proportions from all possible simple random samples of 50 students gives 0.40. Which statement correctly describes estimation in this setting?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The sample proportion is an unbiased estimator of the population proportion, even though this sample gives 0.46.",
      "is_correct": true,
      "rationale": "The sample proportion estimates the population proportion. Because its average across all possible samples equals 0.40, it does not systematically overestimate or underestimate the population proportion; an individual estimate can still differ from 0.40."
     },
     {
      "choice_key": "B",
      "choice_text": "The sample proportion is a biased estimator because this sample gives 0.46, which exceeds 0.40.",
      "is_correct": false,
      "rationale": "Single-sample bias error: one estimate above the parameter does not establish systematic overestimation. Bias concerns the estimator’s average across possible samples, which here equals the population proportion. Fix: Compare the average across possible samples with the population parameter."
     },
     {
      "choice_key": "C",
      "choice_text": "The sample proportion is unbiased, so every simple random sample of 50 students must give 0.40.",
      "is_correct": false,
      "rationale": "Unbiased-means-exact error: unbiasedness describes the average of estimates, not every individual estimate. Sample proportions can vary while averaging to the population proportion. Fix: Distinguish an individual sample’s estimate from the average across possible samples."
     },
     {
      "choice_key": "D",
      "choice_text": "The population proportion 0.40 is an estimator of the sample proportion 0.46.",
      "is_correct": false,
      "rationale": "Parameter–statistic reversal: the population proportion describes the entire district, while the sample proportion describes the selected students. The sample statistic estimates the population parameter, not the reverse. Fix: Identify which quantity describes the sample and which describes the population."
     }
    ]
   },

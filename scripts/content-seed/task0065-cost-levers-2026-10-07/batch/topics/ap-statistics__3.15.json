   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 3,
    "topic_code": "3.15",
    "topic_title": "Carrying Out a Chi-Square Test for Homogeneity or Independence",
    "stem": "A researcher uses a chi-square test of independence to investigate the association between neighborhood and preferred method of transportation among adults in a city. All conditions for the test are met. One cell has an observed count of 10 and an expected count of 8. What is this cell’s contribution to the χ² test statistic?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "0.25",
      "is_correct": false,
      "rationale": "Missing-square error: (10 − 8)/8 = 0.25 uses the difference without squaring it. A chi-square contribution requires the squared difference. Fix: Square the observed-minus-expected difference before dividing by the expected count."
     },
     {
      "choice_key": "B",
      "choice_text": "4",
      "is_correct": false,
      "rationale": "Missing-denominator error: (10 − 8)² = 4 is only the numerator of the contribution. It must be divided by the expected count. Fix: Divide the squared difference by the cell’s expected count."
     },
     {
      "choice_key": "C",
      "choice_text": "0.5",
      "is_correct": true,
      "rationale": "Each cell contributes (observed − expected)²/expected. For this cell, (10 − 8)²/8 = 4/8 = 0.5."
     },
     {
      "choice_key": "D",
      "choice_text": "0.4",
      "is_correct": false,
      "rationale": "Wrong-denominator error: (10 − 8)²/10 = 0.4 divides by the observed count. The chi-square formula divides by the expected count, which is 8. Fix: Label observed and expected counts before substituting into the formula."
     }
    ]
   },

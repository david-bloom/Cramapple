   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 3,
    "topic_code": "3.6",
    "topic_title": "p-Values",
    "stem": "A random sample of 100 adults in a city includes 60 who favor a proposed library levy. Let p be the proportion of all adults in the city who favor the levy. A test of H₀: p = 0.50 against Hₐ: p > 0.50 reports an approximate p-value of 0.023. All conditions for the test are met. Which statement correctly interprets this p-value?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The probability that 50% of all adults in the city favor the levy is approximately 0.023.",
      "is_correct": false,
      "rationale": "This is the probability-of-the-null trap: it assigns a probability to the null hypothesis. The p-value describes possible sample results assuming the null is true, not the probability that it is true. Fix: Begin your interpretation with the assumption that the population proportion equals 0.50."
     },
     {
      "choice_key": "B",
      "choice_text": "If 50% of all adults in the city favor the levy, the probability that a random sample of 100 adults has exactly 60% favoring it is approximately 0.023.",
      "is_correct": false,
      "rationale": "This is the exact-result trap: it includes only the observed outcome. A p-value includes that outcome and outcomes more extreme in the direction of the alternative. Fix: Include sample proportions greater than 0.60 along with the observed proportion."
     },
     {
      "choice_key": "C",
      "choice_text": "If 50% of all adults in the city favor the levy, the probability that a random sample of 100 adults has 60% or less favoring it is approximately 0.023.",
      "is_correct": false,
      "rationale": "This is the reversed-tail trap: it counts outcomes below the observed proportion. The alternative p > 0.50 makes larger sample proportions, not smaller ones, evidence against the null. Fix: Use the alternative’s inequality to choose the tail beyond the observed result."
     },
     {
      "choice_key": "D",
      "choice_text": "If 50% of all adults in the city favor the levy, the probability that a random sample of 100 adults has 60% or more favoring it is approximately 0.023.",
      "is_correct": true,
      "rationale": "A p-value assumes the null hypothesis is true and measures the probability of a result at least as extreme as the observed result. Because the alternative is p > 0.50, results at least as extreme are sample proportions of 0.60 or greater."
     }
    ]
   },

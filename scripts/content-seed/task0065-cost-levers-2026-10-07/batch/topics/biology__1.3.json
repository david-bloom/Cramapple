   "item": {
    "subject_key": "biology",
    "unit_number": 1,
    "topic_code": "1.3",
    "topic_title": "Introduction to Macromolecules",
    "stem": "A cell breaks a covalent bond linking two monomers in a polymer. Which statement correctly identifies this reaction and describes the role of water?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The reaction is dehydration synthesis, and water is released.",
      "is_correct": false,
      "rationale": "The trap is confusing polymer breakdown with polymer building. Dehydration synthesis releases water while forming a covalent bond, but the cell described here is breaking a bond. Fix: Determine whether the reaction joins monomers or separates them before naming it."
     },
     {
      "choice_key": "B",
      "choice_text": "The reaction is hydrolysis, and water is released.",
      "is_correct": false,
      "rationale": "The trap is reversing water's role in hydrolysis. The reaction is correctly named, but hydrolysis consumes water to break the bond rather than producing water. Fix: Place water on the reactant side when describing hydrolysis."
     },
     {
      "choice_key": "C",
      "choice_text": "The reaction is hydrolysis, and water is consumed.",
      "is_correct": true,
      "rationale": "Hydrolysis breaks the bond by adding water, with H attaching to one monomer and OH attaching to the other. Water is therefore a reactant rather than a product."
     },
     {
      "choice_key": "D",
      "choice_text": "The reaction is dehydration synthesis, and water is consumed.",
      "is_correct": false,
      "rationale": "The trap is attaching the wrong reaction name to water consumption. Adding water to cleave a polymer bond describes hydrolysis; dehydration synthesis instead joins monomers and releases water. Fix: Match bond cleavage and water addition to hydrolysis before selecting a reaction name."
     }
    ]
   },

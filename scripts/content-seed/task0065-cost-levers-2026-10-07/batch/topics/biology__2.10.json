   "item": {
    "subject_key": "biology",
    "unit_number": 2,
    "topic_code": "2.10",
    "topic_title": "Origins of Cell Compartmentalization",
    "stem": "Which statement correctly connects the endosymbiotic origin of mitochondria and chloroplasts with differences in compartmentalization between prokaryotic and eukaryotic cells?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Mitochondria and chloroplasts originated solely from folds in a host cell’s membranes; prokaryotic cells typically have specialized internal regions without membrane-bound organelles, whereas eukaryotic cells use internal membranes to partition specialized regions.",
      "is_correct": false,
      "rationale": "Membrane-folding origin trap: This substitutes a change in the host’s membranes for the incorporation of free-living prokaryotes. Endosymbiotic theory identifies those prokaryotes as the ancestors of mitochondria and chloroplasts. Fix: Check whether the proposed origin includes once free-living cells becoming organelles."
     },
     {
      "choice_key": "B",
      "choice_text": "Mitochondria and chloroplasts evolved from free-living prokaryotes; prokaryotic cells lack any specialized internal organization, whereas eukaryotic cells use internal membranes to partition specialized regions.",
      "is_correct": false,
      "rationale": "No-organization trap: Lacking membrane-bound organelles does not mean lacking internal organization. Prokaryotes have specialized internal regions even though they typically lack membrane-bound organelles. Fix: Separate the presence of specialized regions from the presence of membrane-bound organelles."
     },
     {
      "choice_key": "C",
      "choice_text": "Free-living prokaryotes evolved from mitochondria and chloroplasts; prokaryotic cells typically have specialized internal regions without membrane-bound organelles, whereas eukaryotic cells use internal membranes to partition specialized regions.",
      "is_correct": false,
      "rationale": "Reversed-ancestry trap: This reverses the evolutionary relationship described by endosymbiotic theory. Free-living prokaryotes were ancestors of mitochondria and chloroplasts, not descendants of those organelles. Fix: Trace the proposed ancestry from free-living prokaryotes to organelles within host cells."
     },
     {
      "choice_key": "D",
      "choice_text": "Mitochondria and chloroplasts evolved from free-living prokaryotes; prokaryotic cells typically have specialized internal regions without membrane-bound organelles, whereas eukaryotic cells use internal membranes to partition specialized regions.",
      "is_correct": true,
      "rationale": "Endosymbiotic theory explains these organelles as descendants of once free-living prokaryotes that lived within another cell. The compartmentalization comparison distinguishes organization into specialized regions from partitioning by internal membranes."
     }
    ]
   },

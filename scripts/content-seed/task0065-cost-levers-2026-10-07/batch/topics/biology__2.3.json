   "item": {
    "subject_key": "biology",
    "unit_number": 2,
    "topic_code": "2.3",
    "topic_title": "Plasma Membrane",
    "stem": "A protein spans a cell’s plasma membrane, with portions exposed to the watery environments inside and outside the cell. Which arrangement of phospholipids and protein regions is most consistent with the fluid mosaic model?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Phospholipid heads face the watery environments; tails face inward. Hydrophobic protein regions contact the tails, while hydrophilic protein regions face water.",
      "is_correct": true,
      "rationale": "Hydrophilic heads interact with water, while hydrophobic tails form the bilayer’s interior. The protein’s orientation similarly places hydrophobic regions against the tails and hydrophilic regions in contact with water."
     },
     {
      "choice_key": "B",
      "choice_text": "Phospholipid tails face the watery environments; heads face inward. Hydrophobic protein regions contact the tails, while hydrophilic protein regions contact the heads.",
      "is_correct": false,
      "rationale": "The inverted-bilayer trap reverses phospholipid orientation. Hydrophobic tails avoid water, while hydrophilic heads face the watery environments on both sides of the membrane. Fix: Identify the water-facing surfaces, then place hydrophilic heads at those surfaces."
     },
     {
      "choice_key": "C",
      "choice_text": "Phospholipid heads face the watery environments; tails face inward. Hydrophilic protein regions contact the tails, while hydrophobic protein regions face water.",
      "is_correct": false,
      "rationale": "The reversed-protein-orientation trap correctly places phospholipids but mismatches protein regions with their surroundings. Hydrophilic regions favor contact with water, not the hydrophobic tail region. Fix: Match each protein region’s hydrophilic or hydrophobic character to its surroundings."
     },
     {
      "choice_key": "D",
      "choice_text": "Phospholipid heads face the watery environments; tails face inward. Every region of the spanning protein is hydrophobic because the protein is embedded in the membrane.",
      "is_correct": false,
      "rationale": "The uniformly-hydrophobic-protein trap treats membrane location as determining the entire protein’s character. A spanning protein can contain both hydrophobic regions within the bilayer and hydrophilic regions exposed to water. Fix: Evaluate the surroundings of each protein region rather than classifying the whole protein together."
     }
    ]
   },

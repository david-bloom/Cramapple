   "item": {
    "subject_key": "biology",
    "unit_number": 3,
    "topic_code": "3.1",
    "topic_title": "Enzymes",
    "stem": "Substrate X has a shape and charge compatible with an enzyme’s active site. Substrate Y is similar in size to X but has an incompatible shape and charge. Which explanation best predicts how this enzyme affects the reactions of X and Y?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The enzyme speeds X’s reaction by supplying the energy needed to overcome the activation-energy barrier.",
      "is_correct": false,
      "rationale": "Energy-supply misconception: this treats the enzyme as an energy source. Enzymes speed reactions by lowering the activation-energy barrier, not by supplying energy to overcome it. Fix: Check whether the proposed mechanism lowers an energy barrier or supplies energy."
     },
     {
      "choice_key": "B",
      "choice_text": "The enzyme speeds X’s reaction by lowering its activation energy but does not catalyze Y’s reaction because Y cannot bind appropriately.",
      "is_correct": true,
      "rationale": "X can form an enzyme-substrate complex because its shape and charge fit the active site. This interaction lowers the activation-energy barrier, increasing reaction rate; Y’s incompatible shape and charge prevent appropriate binding."
     },
     {
      "choice_key": "C",
      "choice_text": "The enzyme speeds both reactions because substrates of similar size can use the same active site.",
      "is_correct": false,
      "rationale": "Size-only specificity trap: similar size does not establish compatibility with an active site. Substrate shape and charge must also permit appropriate binding, which Y lacks. Fix: Compare both shape and charge with the active site before predicting catalysis."
     },
     {
      "choice_key": "D",
      "choice_text": "The enzyme speeds X’s reaction by raising its activation energy, while Y’s reaction is unaffected.",
      "is_correct": false,
      "rationale": "Activation-energy reversal: raising the energy barrier would hinder a reaction rather than speed it. Enzyme catalysis increases reaction rate by lowering that barrier. Fix: Check whether the stated barrier change makes the reaction easier or harder to initiate."
     }
    ]
   },

   "item": {
    "subject_key": "ap-chemistry",
    "unit_number": 1,
    "topic_code": "1.2",
    "topic_title": "Mass Spectra of Elements",
    "stem": "A mass spectrum of an element X contains only singly charged monatomic ions. It shows two isotope peaks: one at 40.0 amu with 75% relative abundance and one at 44.0 amu with 25% relative abundance. Using these isotope masses, what is the average atomic mass of this sample?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "42.0 amu",
      "is_correct": false,
      "rationale": "Equal-weight averaging: Adding the two isotope masses and dividing by two assumes equal abundances. The spectrum instead shows that the lighter isotope is three times as abundant. Fix: Multiply each isotope mass by its fractional abundance before adding."
     },
     {
      "choice_key": "B",
      "choice_text": "40.0 amu",
      "is_correct": false,
      "rationale": "Most-abundant-isotope substitution: This uses only the mass of the tallest peak. The less abundant isotope also contributes to the average, raising it above 40.0 amu. Fix: Include a weighted contribution from every isotope peak."
     },
     {
      "choice_key": "C",
      "choice_text": "43.0 amu",
      "is_correct": false,
      "rationale": "Abundance reversal: This results from assigning 25% abundance to the 40.0 amu isotope and 75% to the 44.0 amu isotope. Those assignments reverse the measured abundances. Fix: Pair each isotope mass with its own peak’s fractional abundance."
     },
     {
      "choice_key": "D",
      "choice_text": "41.0 amu",
      "is_correct": true,
      "rationale": "Each isotope contributes according to its fractional abundance: (40.0 amu)(0.75) + (44.0 amu)(0.25) = 41.0 amu. The average is closer to 40.0 amu because that isotope is more abundant."
     }
    ]
   },

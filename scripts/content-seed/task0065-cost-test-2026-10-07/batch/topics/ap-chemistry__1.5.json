    "subject_key": "ap-chemistry",
    "unit_number": 1,
    "topic_code": "1.5",
    "topic_title": "Atomic Structure and Electron Configuration",
    "stem": "A neutral sulfur atom has 16 protons. Which electron configuration represents its ground state?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "1s² 2s² 2p⁸ 3s² 3p²",
      "is_correct": false,
      "rationale": "Overfilling a p subshell: Although this configuration totals 16 electrons, a p subshell holds at most six electrons, so 2p⁸ is not allowed. Fix: Check that each p superscript is ≤ 6 before totaling the electrons."
     },
     {
      "choice_key": "B",
      "choice_text": "1s² 2s² 2p⁶ 3s⁴ 3p²",
      "is_correct": false,
      "rationale": "Overfilling an s subshell: Although this configuration totals 16 electrons, an s subshell holds at most two electrons, so 3s⁴ is not allowed. Fix: Check that each s superscript is ≤ 2 before totaling the electrons."
     },
     {
      "choice_key": "C",
      "choice_text": "1s² 2s² 2p⁶ 3s² 3p² 4s²",
      "is_correct": false,
      "rationale": "Premature filling of a higher-energy subshell: This configuration places electrons in 4s while the lower-energy 3p subshell still has room. It therefore does not represent sulfur’s ground state. Fix: Write the Aufbau order through 4s, then fill each lower-energy subshell first."
     },
     {
      "choice_key": "D",
      "choice_text": "1s² 2s² 2p⁶ 3s² 3p⁴",
      "is_correct": true,
      "rationale": "A neutral atom with 16 protons has 16 electrons. Filling subshells in increasing energy order places 12 electrons in 1s, 2s, 2p, and 3s, leaving four electrons for 3p."
     }
    ]
   },

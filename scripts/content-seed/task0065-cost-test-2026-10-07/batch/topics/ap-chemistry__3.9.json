   "item": {
    "subject_key": "ap-chemistry",
    "unit_number": 3,
    "topic_code": "3.9",
    "topic_title": "Separation of Solutions and Mixtures",
    "stem": "A solution contains two molecular dyes, X and Y, both completely dissolved. In a paper chromatography setup, X interacts more strongly with the stationary paper than Y does, while both dyes interact equally strongly with the moving solvent. Which proposed separation method and predicted result are best supported?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Use paper chromatography; Y will travel farther than X.",
      "is_correct": true,
      "rationale": "Chromatography separates substances by their different interactions with the stationary and mobile phases. With equal attraction to the moving solvent, X’s stronger attraction to the paper holds it back more, so Y travels farther."
     },
     {
      "choice_key": "B",
      "choice_text": "Use ordinary filtration; the filter pores will trap the dissolved dyes while the solvent passes through.",
      "is_correct": false,
      "rationale": "Dissolved-solute filtration trap: Ordinary filtration traps suspended particles, not individual dissolved dye molecules. Both dissolved dyes pass through with the solvent, so this method does not separate them from the solution. Fix: Check whether the substances are dissolved or suspended before choosing filtration."
     },
     {
      "choice_key": "C",
      "choice_text": "Use paper chromatography; X will travel farther than Y.",
      "is_correct": false,
      "rationale": "Stationary-phase attraction reversal: Stronger attraction to the paper increases retention rather than movement with the solvent. X is held back more strongly and therefore travels a shorter distance. Fix: Identify which dye is retained more strongly by the stationary phase."
     },
     {
      "choice_key": "D",
      "choice_text": "Use paper chromatography; both dyes will travel the same distance because both are dissolved.",
      "is_correct": false,
      "rationale": "Solubility-only reasoning: Being dissolved allows both dyes to move with the solvent, but does not guarantee equal travel distances. Their unequal attractions to the stationary paper produce different retention. Fix: Compare interactions with both phases instead of checking solubility alone."
     }
    ]
   },

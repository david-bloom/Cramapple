   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 1,
    "topic_code": "1.10",
    "topic_title": "The Investigative Question Revisited and Data Collection",
    "stem": "Researchers want to compare workplace absences among employees who usually walk to work and employees who usually drive. Today, they record each employee’s usual commuting method. They then track absences over the next six months without asking anyone to change commuting methods. Which statement best classifies this study and explains why?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "It is a prospective observational study because researchers impose no treatment and collect absence data going forward.",
      "is_correct": true,
      "rationale": "Researchers record employees’ existing commuting methods rather than impose a treatment, so the study is observational. Tracking absences over the next six months makes it prospective."
     },
     {
      "choice_key": "B",
      "choice_text": "It is a retrospective observational study because employees established their commuting habits before the study began.",
      "is_correct": false,
      "rationale": "This is the existing-habits timing error: a habit’s starting date does not determine whether a study is retrospective. Researchers track future absences rather than look back at past absence records. Fix: Identify whether the outcome data come from past records or future tracking."
     },
     {
      "choice_key": "C",
      "choice_text": "It is an experiment because researchers actively track employees’ absences for six months.",
      "is_correct": false,
      "rationale": "This is the monitoring-as-treatment error: actively measuring outcomes does not impose a treatment. Researchers do not change employees’ commuting methods. Fix: Locate the treatment researchers impose before classifying a study as experimental."
     },
     {
      "choice_key": "D",
      "choice_text": "It is an experiment because researchers compare groups with different commuting methods.",
      "is_correct": false,
      "rationale": "This is the comparison-as-experiment error: comparing existing groups does not make a study experimental. Employees already use their commuting methods; researchers do not impose them. Fix: Check whether researchers imposed the group conditions or merely recorded existing differences."
     }
    ]
   },

   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 3,
    "topic_code": "3.1",
    "topic_title": "Estimators",
    "stem": "At a school, 60% of all students participate in an extracurricular activity. A researcher uses the proportion who participate in a simple random sample of 100 students to estimate this population proportion. Across all possible samples of this size, the average sample proportion is 0.60. One selected sample has a proportion of 0.54. Which statement correctly describes the estimator?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The sample proportion is an unbiased estimator of the population proportion, even though this sample's value is 0.54.",
      "is_correct": true,
      "rationale": "The sample proportion estimates the population proportion. It is unbiased because its average across all possible samples equals 0.60, the population proportion; an individual estimate need not equal that value."
     },
     {
      "choice_key": "B",
      "choice_text": "The sample proportion systematically underestimates the population proportion because this sample's value is 0.54.",
      "is_correct": false,
      "rationale": "Single-sample bias error: one estimate below the population proportion does not establish systematic underestimation. The average across all possible samples equals the population proportion. Fix: Compare the average across possible samples with the population proportion, not one sample's value."
     },
     {
      "choice_key": "C",
      "choice_text": "The sample proportion is biased because different random samples can produce different estimates.",
      "is_correct": false,
      "rationale": "Variability–bias confusion: variation among estimates is not the same as systematic overestimation or underestimation. An unbiased estimator can produce different values across samples while averaging to the population parameter. Fix: Check where estimates average, separately from how much they vary."
     },
     {
      "choice_key": "D",
      "choice_text": "The population proportion 0.60 is the statistic used to estimate the sample parameter 0.54.",
      "is_correct": false,
      "rationale": "Parameter–statistic reversal: 0.60 describes the entire population and is a parameter; 0.54 describes the selected sample and is a statistic. The sample statistic estimates the population parameter, not the reverse. Fix: Label each proportion by whether it describes the sample or the entire population."
     }
    ]
   },

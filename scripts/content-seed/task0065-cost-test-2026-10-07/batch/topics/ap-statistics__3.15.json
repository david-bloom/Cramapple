   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 3,
    "topic_code": "3.15",
    "topic_title": "Carrying Out a Chi-Square Test for Homogeneity or Independence",
    "stem": "A researcher is carrying out a chi-square test of independence between age group and preferred mode of transportation using a random sample of adults. One cell in the two-way table has an observed count of 20 and an expected count of 16. What is this cell’s contribution to the chi-square test statistic?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "0.25",
      "is_correct": false,
      "rationale": "Unsquared-difference error: (20 − 16)/16 = 0.25 omits the required square. Chi-square contributions use squared differences so positive and negative deviations cannot cancel. Fix: Square the observed-minus-expected difference before dividing by the expected count."
     },
     {
      "choice_key": "B",
      "choice_text": "0.8",
      "is_correct": false,
      "rationale": "Observed-denominator error: (20 − 16)²/20 = 0.8 divides by the observed count. The formula scales each squared difference by the expected count, not the observed count. Fix: Label the expected count and use it as the denominator."
     },
     {
      "choice_key": "C",
      "choice_text": "1",
      "is_correct": true,
      "rationale": "Each cell contributes (observed − expected)²/expected. This cell contributes (20 − 16)²/16 = 16/16 = 1."
     },
     {
      "choice_key": "D",
      "choice_text": "16",
      "is_correct": false,
      "rationale": "Missing-denominator error: (20 − 16)² = 16 gives only the numerator. A chi-square contribution must also divide this squared difference by the expected count. Fix: Divide the squared difference by the expected count before recording the contribution."
     }
    ]
   },

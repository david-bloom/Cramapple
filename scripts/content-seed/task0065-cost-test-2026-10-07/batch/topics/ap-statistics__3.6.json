   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 3,
    "topic_code": "3.6",
    "topic_title": "p-Values",
    "stem": "Let p be the proportion of all residents in a town who support a proposal. In a random sample of 100 residents, 60 support it. A test of H₀: p = 0.50 against Hₐ: p > 0.50 gives an approximate p-value of 0.023. All conditions for the test are satisfied. Which statement correctly interprets this p-value?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Given the sample results, the probability that exactly 50% of all town residents support the proposal is approximately 0.023.",
      "is_correct": false,
      "rationale": "This is the probability-of-the-null trap: a p-value is not the probability that H₀ is true. It describes possible sample results under the assumption that H₀ is true. Fix: Begin your interpretation by assuming the null hypothesis is true."
     },
     {
      "choice_key": "B",
      "choice_text": "Assuming 50% of all town residents support the proposal, the probability that a random sample of 100 residents includes exactly 60 supporters is approximately 0.023.",
      "is_correct": false,
      "rationale": "This is the exact-result trap: the p-value includes results more extreme than the observed result, not just the observed result itself. Here, samples with more than 60 supporters also count. Fix: Include the observed result and every result more extreme in the alternative's direction."
     },
     {
      "choice_key": "C",
      "choice_text": "Assuming 50% of all town residents support the proposal, the probability that a random sample of 100 residents includes at most 60 supporters is approximately 0.023.",
      "is_correct": false,
      "rationale": "This is the wrong-tail trap: at most 60 counts results in the wrong direction. The alternative p > 0.50 makes larger supporter counts, not smaller counts, evidence against H₀. Fix: Use the alternative hypothesis to choose the direction of more extreme results."
     },
     {
      "choice_key": "D",
      "choice_text": "Assuming 50% of all town residents support the proposal, the probability that a random sample of 100 residents includes at least 60 supporters is approximately 0.023.",
      "is_correct": true,
      "rationale": "A p-value assumes the null hypothesis is true and measures the probability of a result at least as extreme as the observed result. Because the alternative is p > 0.50, at least as extreme means 60 or more supporters."
     }
    ]
   },

   "item": {
    "subject_key": "biology",
    "unit_number": 1,
    "topic_code": "1.3",
    "topic_title": "Introduction to Macromolecules",
    "stem": "A reaction converts one polymer into two shorter chains by breaking a covalent bond between its subunits. Which statement correctly explains this reaction?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Hydrolysis releases water as the covalent bond between subunits breaks.",
      "is_correct": false,
      "rationale": "Water-direction reversal: this identifies the breakdown process but incorrectly makes water a product. Hydrolysis consumes water, supplying H and OH to the fragments. Fix: Place water on the reactant side when representing hydrolysis."
     },
     {
      "choice_key": "B",
      "choice_text": "Dehydration synthesis releases water as the covalent bond between subunits breaks.",
      "is_correct": false,
      "rationale": "Process reversal: this applies a polymer-building reaction to polymer breakdown. Dehydration synthesis releases water while forming a covalent bond between subunits, rather than breaking that bond. Fix: Check whether the products are joined subunits or separated fragments before naming the reaction."
     },
     {
      "choice_key": "C",
      "choice_text": "Hydrolysis consumes water to break the covalent bond between subunits.",
      "is_correct": true,
      "rationale": "The polymer is being split, so the reaction is hydrolysis. Water supplies H to one newly formed end and OH to the other as the covalent bond is broken."
     },
     {
      "choice_key": "D",
      "choice_text": "Hydrolysis consumes water to form a new covalent bond between the two chains.",
      "is_correct": false,
      "rationale": "Bond-change reversal: this correctly associates hydrolysis with water consumption but incorrectly describes bond formation. The stated reaction separates a polymer by cleaving an existing covalent bond. Fix: Compare the starting polymer with the products to determine whether a bond forms or breaks."
     }
    ]
   },

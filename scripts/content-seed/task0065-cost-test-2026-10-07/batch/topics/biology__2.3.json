   "item": {
    "subject_key": "biology",
    "unit_number": 2,
    "topic_code": "2.3",
    "topic_title": "Plasma Membrane",
    "stem": "Water is present both inside and outside a cell, and a protein spans its plasma membrane. Which description of membrane organization is consistent with the fluid mosaic model?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Phospholipid heads face water, tails face the bilayer interior, and hydrophobic protein regions contact the tails; membrane components can move laterally.",
      "is_correct": true,
      "rationale": "Hydrophilic heads interact with the aqueous environments, while hydrophobic tails cluster inside the bilayer. Hydrophobic regions anchor the protein within this interior, and lateral movement of components makes the membrane fluid."
     },
     {
      "choice_key": "B",
      "choice_text": "Phospholipid tails face water, heads face the bilayer interior, and hydrophobic protein regions contact the heads; membrane components can move laterally.",
      "is_correct": false,
      "rationale": "Reversed phospholipid orientation: this arrangement exposes hydrophobic tails to water and buries hydrophilic heads. It also places hydrophobic protein regions against the wrong phospholipid region. Fix: Label heads hydrophilic and tails hydrophobic, then orient each relative to water."
     },
     {
      "choice_key": "C",
      "choice_text": "Phospholipid heads face water, tails face the bilayer interior, and hydrophilic protein regions contact the tails; membrane components can move laterally.",
      "is_correct": false,
      "rationale": "Protein polarity mismatch: this places hydrophilic protein regions against the hydrophobic bilayer interior. A spanning protein has hydrophobic regions where it contacts phospholipid tails. Fix: Match each protein region's polarity to the membrane region it contacts."
     },
     {
      "choice_key": "D",
      "choice_text": "Phospholipid heads face water, tails face the bilayer interior, and hydrophobic protein regions contact the tails; all membrane components remain fixed in position.",
      "is_correct": false,
      "rationale": "Rigid membrane misconception: correct component orientation does not make the membrane a stationary structure. The fluid mosaic model includes lateral movement of phospholipids and many proteins. Fix: Check whether the description allows membrane components to move within the bilayer."
     }
    ]
   },

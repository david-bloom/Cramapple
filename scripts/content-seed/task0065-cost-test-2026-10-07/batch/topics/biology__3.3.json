   "item": {
    "subject_key": "biology",
    "unit_number": 3,
    "topic_code": "3.3",
    "topic_title": "Cellular Energy",
    "stem": "A cell joins small molecules into a larger molecule through a reaction that requires energy input. Under the same conditions, ATP hydrolysis releases enough energy to supply that input. Which explanation best describes how ATP hydrolysis can drive the building reaction?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "ATP hydrolysis creates new energy that the cell uses to assemble the larger molecule.",
      "is_correct": false,
      "rationale": "The energy-creation misconception treats ATP as a source of newly created energy. ATP hydrolysis releases energy that can be transferred to cellular work; it does not violate energy conservation. Fix: Trace the energy transfer instead of describing energy as newly created."
     },
     {
      "choice_key": "B",
      "choice_text": "ATP hydrolysis lowers activation energy, so molecule assembly no longer requires energy input.",
      "is_correct": false,
      "rationale": "The activation-energy/net-energy confusion mistakes a reaction barrier for its energy requirement. Lowering activation energy can increase reaction rate, but it does not eliminate the net energy input required for assembly. Fix: Separate the reaction's activation barrier from its net energy requirement."
     },
     {
      "choice_key": "C",
      "choice_text": "ATP hydrolysis automatically powers molecule assembly whenever both reactions occur in the same cell.",
      "is_correct": false,
      "rationale": "The proximity-equals-coupling misconception assumes that sharing a location guarantees energy transfer. The reactions must be coupled so that energy released by ATP hydrolysis supports assembly; coexistence alone is insufficient. Fix: Identify the coupling that connects energy release to the specific cellular work."
     },
     {
      "choice_key": "D",
      "choice_text": "The cell couples ATP hydrolysis to molecule assembly, using the released energy to drive the energy-requiring reaction.",
      "is_correct": true,
      "rationale": "Molecule assembly requires energy input, while ATP hydrolysis releases energy. Coupling these processes allows energy released by hydrolysis to support assembly; simply having ATP present does not explain how the work is powered."
     }
    ]
   },

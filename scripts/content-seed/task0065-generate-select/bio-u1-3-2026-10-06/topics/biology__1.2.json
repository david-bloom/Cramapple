   "item": {
    "subject_key": "biology",
    "unit_number": 1,
    "topic_code": "1.2",
    "topic_title": "Elements of Life",
    "stem": "A growing cell must build nucleic acids to store genetic information and phospholipids to form cell membranes. Which explanation correctly connects an element to the molecules needed for these tasks?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Sulfur is a component of both nucleic acids and phospholipids, so it supplies building material for information storage and membrane construction.",
      "is_correct": false,
      "rationale": "Element–molecule mismatch: This confuses sulfur's role in proteins with phosphorus's role in nucleic acids and phospholipids. Fix: Match each named element to the biological molecules that contain it before connecting those molecules to their functions."
     },
     {
      "choice_key": "B",
      "choice_text": "Nitrogen is needed for proteins but not nucleic acids, so building molecules that store genetic information does not require nitrogen.",
      "is_correct": false,
      "rationale": "Protein-only nitrogen trap: Nitrogen occurs in amino acids, but it is also a component of nucleic acids. Fix: Check whether an element contributes to more than one molecule class before restricting it to a single cellular role."
     },
     {
      "choice_key": "C",
      "choice_text": "Phosphorus is a component of both nucleic acids and phospholipids, so it supplies building material for information storage and membrane construction.",
      "is_correct": true,
      "rationale": "Cells need phosphorus because it is incorporated into both nucleic acids and phospholipids. This connects the element to the molecules it helps build and then to their roles in storing information and forming membranes."
     },
     {
      "choice_key": "D",
      "choice_text": "Carbon, hydrogen, and oxygen are the most prevalent elements in biological molecules, so these three elements alone can build nucleic acids and phospholipids.",
      "is_correct": false,
      "rationale": "Abundance-means-sufficiency trap: Being the most prevalent elements does not make carbon, hydrogen, and oxygen the only required elements; both named molecule classes also require phosphorus. Fix: Check the required elements of each named molecule rather than treating the most abundant elements as a complete ingredient list."
     }
    ]
   },

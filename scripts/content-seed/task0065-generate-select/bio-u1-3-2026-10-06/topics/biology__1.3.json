   "item": {
    "subject_key": "biology",
    "unit_number": 1,
    "topic_code": "1.3",
    "topic_title": "Introduction to Macromolecules",
    "stem": "A cell joins a free monomer to the end of an existing polymer, increasing the number of linked subunits by one. Which statement correctly describes this reaction?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Hydrolysis consumes water and cleaves a covalent bond between subunits of the polymer.",
      "is_correct": false,
      "rationale": "Building–breaking reversal: This describes polymer breakdown, but the stem describes adding a subunit. Hydrolysis uses water to cleave a bond rather than attach a monomer. Fix: Ask whether the polymer gains or loses linked subunits before naming the reaction."
     },
     {
      "choice_key": "B",
      "choice_text": "Dehydration synthesis consumes water and forms a covalent bond between the monomer and the polymer.",
      "is_correct": false,
      "rationale": "Water-direction reversal: The bond formation is appropriate, but dehydration synthesis releases water rather than consuming it. Fix: Track the removed H and OH, and place the resulting water on the product side."
     },
     {
      "choice_key": "C",
      "choice_text": "Dehydration synthesis releases water and forms a covalent bond between the monomer and the polymer.",
      "is_correct": true,
      "rationale": "The polymer becomes longer, so the reaction must form a covalent bond that attaches the new monomer. This joining reaction is dehydration synthesis: H and OH are removed from the joining subunits and released as water."
     },
     {
      "choice_key": "D",
      "choice_text": "Dehydration synthesis releases water and cleaves a covalent bond between subunits of the polymer.",
      "is_correct": false,
      "rationale": "Bond-direction reversal: Water release matches dehydration synthesis, but cleaving a bond between polymer subunits does not attach the new monomer. Polymer growth requires formation of a connecting covalent bond. Fix: Identify the connection needed to attach the new monomer, then check whether the choice forms or cleaves that bond."
     }
    ]

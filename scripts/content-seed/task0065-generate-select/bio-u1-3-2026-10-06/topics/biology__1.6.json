   "item": {
    "subject_key": "biology",
    "unit_number": 1,
    "topic_code": "1.6",
    "topic_title": "Nucleic Acids",
    "stem": "One strand of a DNA double helix has the sequence 5'-ATGCCA-3'. Which sequence correctly represents the complementary DNA strand written in the 5' to 3' direction?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "5'-TACGGT-3'",
      "is_correct": false,
      "rationale": "This is the parallel-strand error. The bases are correctly complementary, but they are labeled as if both strands ran in the same direction. DNA strands are antiparallel, so the base pairing with the original 5' end sits at the complementary strand's 3' end. Fix: Write the complement under the original with opposite end labels, then reverse it to read 5' to 3'."
     },
     {
      "choice_key": "B",
      "choice_text": "5'-UGGCAU-3'",
      "is_correct": false,
      "rationale": "This mixes DNA and RNA by pairing A with uracil. Uracil occurs in RNA, and the question asks for the complementary DNA strand, which pairs A with thymine. Fix: Ask whether the product is DNA or RNA before choosing T or U as A's partner."
     },
     {
      "choice_key": "C",
      "choice_text": "5'-TGGCAT-3'",
      "is_correct": true,
      "rationale": "In DNA, A pairs with T and C pairs with G, and the two strands are antiparallel. Pairing base by base gives 3'-TACGGT-5'. Reading that strand from its 5' end gives 5'-TGGCAT-3'. The complementary sequence lets either strand serve as a template for copying the stored information."
     },
     {
      "choice_key": "D",
      "choice_text": "5'-ACCGTA-3'",
      "is_correct": false,
      "rationale": "This is the original sequence written backward without pairing any bases. Reversing the order deals with antiparallel direction but ignores complementarity. Every A should become T and every C should become G. Fix: Replace each base with its pairing partner first, then reverse the order to read the new strand 5' to 3'."
     }
    ]
   },

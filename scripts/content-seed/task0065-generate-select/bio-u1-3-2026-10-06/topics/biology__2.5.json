   "item": {
    "subject_key": "biology",
    "unit_number": 2,
    "topic_code": "2.5",
    "topic_title": "Membrane Transport",
    "stem": "Two uncharged solutes move into a cell through separate membrane proteins. Solute X has a concentration of 8 mmol/L outside and 2 mmol/L inside; its net inward transport requires no energy input. Solute Y has a concentration of 1 mmol/L outside and 6 mmol/L inside; its net transport is also inward. Which statement correctly identifies the gradient directions, transport types, and energy requirements?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "X moves high-to-low and Y moves low-to-high, but both use active transport requiring ATP because both use membrane proteins.",
      "is_correct": false,
      "rationale": "Protein-means-ATP trap: using a membrane protein does not automatically make transport active or ATP-dependent, and X explicitly requires no energy input. Fix: Compare the concentrations and check the energy requirement before classifying protein-mediated movement."
     },
     {
      "choice_key": "B",
      "choice_text": "X moves high-to-low by passive transport without energy input; Y moves low-to-high by active transport requiring energy.",
      "is_correct": true,
      "rationale": "Inward movement takes X from 8 to 2 mmol/L, down its concentration gradient, without energy input. It takes Y from 1 to 6 mmol/L, against its gradient, which requires energy. Protein involvement alone does not determine whether transport is passive or active."
     },
     {
      "choice_key": "C",
      "choice_text": "X moves high-to-low and Y moves low-to-high, but both use passive transport without energy input because both enter the cell.",
      "is_correct": false,
      "rationale": "Inward-means-passive trap: entering a cell does not determine transport type; Y enters from a lower concentration to a higher concentration, requiring energy. Fix: Label the starting and ending concentrations for each solute rather than using inward movement to classify transport."
     },
     {
      "choice_key": "D",
      "choice_text": "X moves low-to-high by active transport requiring energy; Y moves high-to-low by passive transport without energy input.",
      "is_correct": false,
      "rationale": "Reversed-gradient trap: this swaps the starting and ending concentrations for inward movement; X moves from 8 to 2 mmol/L, while Y moves from 1 to 6 mmol/L. Fix: Write outside → inside, insert each solute’s concentrations, and then identify high-to-low or low-to-high movement."
     }
    ]
   },

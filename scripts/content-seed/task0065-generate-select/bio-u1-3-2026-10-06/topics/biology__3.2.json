   "item": {
    "subject_key": "biology",
    "unit_number": 3,
    "topic_code": "3.2",
    "topic_title": "Environmental Impacts on Enzyme Function",
    "stem": "A researcher incubates equal amounts of an enzyme without substrate for 10 minutes at different temperatures. Each sample is then brought to 25°C, and the same concentration of fresh substrate is added. All other conditions, including pH, are identical. Initial reaction rates measured at 25°C are:\n\nPrior incubation temperature | Initial reaction rate\n20°C | 100 units/min\n40°C | 100 units/min\n70°C | 5 units/min\n\nWhich explanation best connects the low activity of the sample previously incubated at 70°C to a molecular cause?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Cooling to 25°C caused fewer enzyme–substrate collisions in the sample previously incubated at 70°C than in the other samples.",
      "is_correct": false,
      "rationale": "Trap: confusing treatment temperature with measurement temperature. All samples react at 25°C with equal enzyme and substrate concentrations, so their different rates cannot be explained by different measurement temperatures. Fix: Separate the prior treatment conditions from the conditions present when reaction rates are measured."
     },
     {
      "choice_key": "B",
      "choice_text": "Heating to 70°C used up most of the substrate, leaving less available when the reaction rate was measured.",
      "is_correct": false,
      "rationale": "Trap: attributing reduced activity to substrate depletion. No substrate was present during heating, and equal concentrations of fresh substrate were added afterward. Fix: Check when substrate was added and whether its starting concentration differed among samples."
     },
     {
      "choice_key": "C",
      "choice_text": "Heating to 70°C likely disrupted interactions maintaining the enzyme’s shape, leaving an altered active site that functions poorly at 25°C.",
      "is_correct": true,
      "rationale": "The rate is much lower after the 70°C treatment even though measurement conditions are identical. High temperature can disrupt interactions such as hydrogen bonds, causing denaturation that alters active-site fit and reduces catalysis; cooling does not necessarily restore the functional shape."
     },
     {
      "choice_key": "D",
      "choice_text": "Heating to 70°C denatured the enzyme by necessarily breaking the peptide bonds joining its amino acids.",
      "is_correct": false,
      "rationale": "Trap: confusing denaturation with breakdown of primary structure. Denaturation can disrupt the interactions maintaining a protein’s folded shape without breaking its peptide bonds. Fix: Identify whether the proposed mechanism changes protein folding or breaks the amino-acid chain."
     }
    ]
   },
   "eval": {
    "lint": [],
    "solve": {
     "anthropic/claude-opus-5.5": {
      "pass": true,
      "samples": [
       {
        "ok": true,
        "object": {

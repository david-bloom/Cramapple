   "item": {
    "subject_key": "biology",
    "unit_number": 3,
    "topic_code": "3.5",
    "topic_title": "Cellular Respiration",
    "stem": "An animal cell breaking down glucose releases CO₂, consumes O₂, and produces ATP. Which explanation correctly connects glucose breakdown to ATP production by oxidative phosphorylation?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "Electron carriers deliver electrons from glucose breakdown to the electron transport chain. The chain transfers electrons to O₂, which directly supplies the energy for ATP synthesis without requiring a proton gradient.",
      "is_correct": false,
      "rationale": "Direct-oxygen trap: O₂ accepts electrons at the end of the chain, but ATP synthesis by oxidative phosphorylation depends on a proton gradient, not energy supplied directly by O₂. Fix: Trace the energy pathway from electron transfer to the proton gradient to ATP synthase."
     },
     {
      "choice_key": "B",
      "choice_text": "Carbon released as CO₂ carries energy from glucose breakdown to the electron transport chain. The chain uses that CO₂ to build a proton gradient, which powers ATP synthase while O₂ accepts electrons.",
      "is_correct": false,
      "rationale": "Carbon–electron confusion: CO₂ is a carbon-containing waste product, not the carrier delivering electrons to the electron transport chain. Electron carriers connect glucose oxidation to gradient formation. Fix: Track carbon and electrons separately, identifying which molecules leave as waste and which deliver electrons."
     },
     {
      "choice_key": "C",
      "choice_text": "Electron carriers deliver electrons from glucose breakdown to the electron transport chain. Electron transfer builds a proton gradient, proton flow through ATP synthase drives ATP production, and O₂ accepts electrons at the end of the chain.",
      "is_correct": true,
      "rationale": "Glucose breakdown releases carbon as CO₂ and transfers electrons to carriers. Energy from electron transfer builds the proton gradient that powers ATP synthase; O₂ maintains electron flow by serving as the final electron acceptor rather than making ATP directly."
     },
     {
      "choice_key": "D",
      "choice_text": "Electron carriers deliver electrons from glucose breakdown to the electron transport chain. The chain builds a proton gradient, but electrons flowing through ATP synthase directly drive ATP production before being accepted by O₂.",
      "is_correct": false,
      "rationale": "Electron–proton confusion: Electrons move through the electron transport chain, whereas protons flow through ATP synthase to drive ATP production. Fix: Label the particles moving through the electron transport chain and ATP synthase before explaining ATP production."
     }
    ]
   },

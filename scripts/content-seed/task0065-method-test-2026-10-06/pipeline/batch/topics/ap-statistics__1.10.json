   "item": {
    "subject_key": "ap-statistics",
    "unit_number": 1,
    "topic_code": "1.10",
    "topic_title": "The Investigative Question Revisited and Data Collection",
    "stem": "Researchers want to investigate whether adults who regularly walk to work have different sleep durations from adults who do not. They enroll adults today and record their usual commuting habits. For the next six months, researchers measure each adult’s sleep duration weekly and compare the two groups. Researchers do not assign commuting methods or ask anyone to change their habits. Which classification and explanation best describe this study?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "A prospective observational study, because researchers impose no treatment and collect sleep data going forward from enrollment.",
      "is_correct": true,
      "rationale": "Researchers record commuting habits without assigning or changing them, so the study is observational. The sleep measurements are collected over the next six months, making it prospective."
     },
     {
      "choice_key": "B",
      "choice_text": "A retrospective observational study, because the adults’ commuting habits existed before enrollment.",
      "is_correct": false,
      "rationale": "The trap is using the age of a habit to determine the study’s time direction. Existing commuting habits do not make this retrospective; researchers collect sleep data going forward rather than looking back through past records. Fix: Locate when the study’s data are collected, not when the subjects’ habits began."
     },
     {
      "choice_key": "C",
      "choice_text": "An experiment, because researchers repeatedly measure the adults’ sleep over six months.",
      "is_correct": false,
      "rationale": "The trap is treating repeated measurement as an imposed treatment. Tracking sleep over time records an outcome but does not assign or change the adults’ commuting habits. Fix: Ask what treatment researchers imposed before classifying repeated tracking as an experiment."
     },
     {
      "choice_key": "D",
      "choice_text": "An experiment, because researchers compare adults who walk to work with adults who do not.",
      "is_correct": false,
      "rationale": "The trap is assuming that comparing groups makes a study experimental. These groups arise from existing habits, not treatments imposed by the researchers; observational studies can also compare groups. Fix: Check whether researchers created the groups by imposing treatments or simply recorded existing differences."
     }
    ]
   },

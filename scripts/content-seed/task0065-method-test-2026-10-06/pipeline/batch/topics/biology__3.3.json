   "item": {
    "subject_key": "biology",
    "unit_number": 3,
    "topic_code": "3.3",
    "topic_title": "Cellular Energy",
    "stem": "A membrane pump moves a solute from a region of lower concentration to a region of higher concentration, a process that requires energy input. During each pumping cycle, ATP is converted to ADP and inorganic phosphate. Which explanation best connects this ATP conversion to the work performed by the pump?",
    "choices": [
     {
      "choice_key": "A",
      "choice_text": "The presence of ATP supplies the required energy, so the pump could perform the same work without converting ATP to ADP and phosphate.",
      "is_correct": false,
      "rationale": "ATP-as-energy trap: Merely having ATP nearby does not explain how energy is transferred to the pump. In this pumping cycle, ATP hydrolysis must be coupled to solute movement. Fix: Identify the energy-releasing reaction and explain how it is linked to the work being performed."
     },
     {
      "choice_key": "B",
      "choice_text": "Movement of the solute against its concentration gradient releases energy that drives the conversion of ATP to ADP and phosphate.",
      "is_correct": false,
      "rationale": "Reversed-coupling trap: This reverses the roles of the two processes. The stated solute movement requires energy input; ATP hydrolysis is the energy-releasing process that supports it. Fix: Mark which process requires energy and which releases energy before describing the direction of energy transfer."
     },
     {
      "choice_key": "C",
      "choice_text": "ATP hydrolysis creates new energy that the pump uses to move the solute against its concentration gradient.",
      "is_correct": false,
      "rationale": "Energy-creation trap: ATP hydrolysis does not create energy, because energy is conserved. It releases chemical energy that can be transferred through coupling to support cellular work. Fix: Check whether your explanation describes energy transfer or transformation rather than the creation of new energy."
     },
     {
      "choice_key": "D",
      "choice_text": "ATP hydrolysis releases energy that is coupled to the energy-requiring movement of the solute against its concentration gradient.",
      "is_correct": true,
      "rationale": "Moving the solute against its concentration gradient requires energy input. Coupling that movement to energy-releasing ATP hydrolysis allows the pump to perform work that would otherwise be energetically unfavorable."
     }
    ]
   },
